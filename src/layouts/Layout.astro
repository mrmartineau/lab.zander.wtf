---
import '@mrmartineau/zui/css'

interface Props {
	title?: string
	/** Disable pinch / double-tap zoom — for game-like, app-like pages. */
	lockZoom?: boolean
}

const { title = 'lab.zander.wtf', lockZoom = false } = Astro.props
const viewport = lockZoom
	? 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no'
	: 'width=device-width, initial-scale=1'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta content="Ideas, experiments, toys and small tools. Some of them work." name="description" />
		<link rel="icon" type="image/svg+xml" href="https://zander.wtf/favicon.svg" />
		<meta name="viewport" content={viewport} />
		{
			/* iOS Safari ignores the viewport flags above, so block its pinch
			   gestures directly; `touch-action` (below) kills double-tap zoom. */
			lockZoom && (
				<script is:inline>
					document.addEventListener('gesturestart', (e) =>
						e.preventDefault(),
					)
					document.addEventListener('gesturechange', (e) =>
						e.preventDefault(),
					)
				</script>
			)
		}
		<meta name="generator" content={Astro.generator} />
		<!-- Phosphor Icons — ZUI components reference `ph ph-*` classes -->
		<link
			rel="stylesheet"
			href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css"
		/>
	</head>
	<body class:list={[{ 'lock-zoom': lockZoom }]}>
		<slot />
	</body>
</html>

<style>
	:root {
  /* Colours — black + one yellow accent on off-white */
  --color-accent: light-dark(var(--color-yellow-400), var(--color-yellow-400));
  --color-theme: light-dark(#111111, #fafafa);
  --color-background: light-dark(#faf9f0, #111111);
  --color-surface: light-dark(#ffffff, #1a1a1a);
  --color-border: light-dark(#111111, #fafafa);
  --color-text: light-dark(#111111, #fafafa);

  /* Typography — geometric sans + mono code */
  --font-display: 'Space Grotesk', var(--font-stack-sans);
  --font-body: 'Space Grotesk', var(--font-stack-sans);
  --font-code: 'Space Mono', var(--font-stack-mono);

  /* Shape — hard corners */
  --radius-scale: 0;
  --line-height: var(--line-height-md);
  --border-style: solid;
}

	body {
		margin: 0;
		min-height: 100dvh;
	}
	/* Disable the double-tap-to-zoom gesture on zoom-locked pages. */
	body.lock-zoom {
		touch-action: manipulation;
	}
</style>
