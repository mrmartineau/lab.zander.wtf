---
import '@mrmartineau/zui/css'
import { buildLabItems } from '../data/lab'

interface Props {
	title?: string
	/** Disable pinch / double-tap zoom — for game-like, app-like pages. */
	lockZoom?: boolean
	/** Skip the lab bar and footer — for full-screen pages. */
	bare?: boolean
}

const { title = 'lab.zander.wtf', lockZoom = false, bare = false } = Astro.props

// Lab item pages (`/<slug>`) get a bar with a quick switcher and a footer.
const slug = Astro.url.pathname.split('/').filter(Boolean)[0]
const showChrome = Boolean(slug) && !bare
const items = showChrome
	? buildLabItems(import.meta.glob('../pages/*/index.{astro,md}', { eager: true }))
	: []
const viewport = lockZoom
	? 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no'
	: 'width=device-width, initial-scale=1'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta content="Ideas, experiments, toys and small tools. Some of them work." name="description" />
		<link rel="icon" type="image/svg+xml" href="https://zander.wtf/favicon.svg" />
		<meta name="viewport" content={viewport} />
		{
			/* iOS Safari ignores the viewport flags above, so block its pinch
			   gestures directly; `touch-action` (below) kills double-tap zoom. */
			lockZoom && (
				<script is:inline>
					document.addEventListener('gesturestart', (e) =>
						e.preventDefault(),
					)
					document.addEventListener('gesturechange', (e) =>
						e.preventDefault(),
					)
				</script>
			)
		}
		<meta name="generator" content={Astro.generator} />
		<!-- Phosphor Icons — ZUI components reference `ph ph-*` classes -->
		<link
			rel="stylesheet"
			href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css"
		/>
	</head>
	<body class:list={[{ 'lock-zoom': lockZoom, 'has-chrome': showChrome }]}>
		{
			showChrome && (
				<nav class="lab-bar" aria-label="Lab">
					<a class="lab-home" href="/">
						lab<span>.</span>zander<span>.</span>wtf
					</a>
					<span class="lab-sep" aria-hidden="true">/</span>
					<label class="lab-switch">
						<span class="sr-only">Switch lab item</span>
						<select class="lab-select">
							{items.map((item) => (
								<option value={item.slug} selected={item.slug === slug}>
									{item.slug}
								</option>
							))}
						</select>
						<i class="ph ph-caret-down" aria-hidden="true"></i>
					</label>
				</nav>
			)
		}
		<slot />
		{
			showChrome && (
				<footer class="lab-footer">
					<span>© {new Date().getFullYear()} Zander Martineau</span>
					<a href="https://zander.wtf">zander.wtf</a>
				</footer>
			)
		}
		<script>
			document
				.querySelector<HTMLSelectElement>('.lab-select')
				?.addEventListener('change', (e) => {
					location.href = `/${(e.target as HTMLSelectElement).value}`
				})
		</script>
	</body>
</html>

<style>
	:root {
  /* Colours — black + one yellow accent on off-white */
  --color-accent: light-dark(var(--color-yellow-400), var(--color-yellow-400));
  --color-theme: light-dark(#111111, #fafafa);
  --color-background: light-dark(#faf9f0, #111111);
  --color-surface: light-dark(#ffffff, #1a1a1a);
  --color-border: light-dark(#111111, #fafafa);
  --color-text: light-dark(#111111, #fafafa);

  /* Typography — geometric sans + mono code */
  --font-display: 'Space Grotesk', var(--font-stack-sans);
  --font-body: 'Space Grotesk', var(--font-stack-sans);
  --font-code: 'Space Mono', var(--font-stack-mono);

  /* Shape — hard corners */
  --radius-scale: 0;
  --line-height: var(--line-height-md);
  --border-style: solid;
}

	body {
		margin: 0;
		min-height: 100dvh;
	}
	.lab-bar {
		display: flex;
		align-items: baseline;
		gap: var(--space-2xs);
		padding: var(--space-xs) var(--space-md);
		border-block-end: var(--border-style) 2px var(--color-border);
		font-size: var(--step-0);
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.lab-home {
		color: inherit;
		text-decoration: none;
	}
	.lab-home span {
		color: var(--color-accent);
	}
	.lab-home:hover {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 3px;
	}
	.lab-sep {
		opacity: 0.4;
	}
	.lab-switch {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-width: 0;
	}
	.lab-select {
		appearance: none;
		min-width: 0;
		max-width: 100%;
		padding: 0 calc(1em + var(--space-3xs)) 0 0;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		font-family: var(--font-code);
		font-weight: 400;
		/* Size to the chosen slug, not the longest option. */
		field-sizing: content;
		text-overflow: ellipsis;
		cursor: pointer;
	}
	.lab-select:focus-visible {
		outline: var(--border-style) 2px var(--color-accent);
		outline-offset: 2px;
	}
	.lab-switch i {
		position: absolute;
		inset-inline-end: 0;
		pointer-events: none;
	}
	/* Push the footer to the bottom on short pages. */
	body.has-chrome {
		display: flex;
		flex-direction: column;
	}
	.lab-footer {
		margin-block-start: auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2xs);
		padding: var(--space-sm) var(--space-md);
		border-block-start: var(--border-style) 2px var(--color-border);
		font-family: var(--font-code);
		font-size: var(--step--1);
	}
	.lab-footer a {
		color: inherit;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	/* Disable the double-tap-to-zoom gesture on zoom-locked pages. */
	body.lock-zoom {
		touch-action: manipulation;
	}
</style>
