---
import Layout from '../../layouts/Layout.astro'
import { Badge, Link } from '@mrmartineau/zui/astro'
import Studio from '../../components/word-art/Studio'
import '../../components/word-art/word-art.css'

export const title = 'WordArt Studio'
export const description =
	'The 90s WordArt dialog, rebuilt with modern CSS — any Google Font, gradient fills, 3D extrusion, arches, circles and waves, animation, and copy-paste CSS.'
export const date = '2026-10-03'
export const status = 'live'
export const tags = ['tool', 'css', 'typography', 'fun', 'solid']
---

<Layout title="WordArt Studio — lab.zander.wtf">
	<main class="wa-app">
		<header class="wa-header">
			<!-- The page title is WordArt too, so it needs its font -->
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&display=swap" />
			<Link href="/">← All lab items</Link>
			<div class="wa-title">
				<h1>WordArt <span>Studio</span></h1>
				<Badge variant="fill" color="emerald">live</Badge>
			</div>
			<p class="wa-intro">{description}</p>
		</header>

		<Studio client:only="solid-js">
			<p class="wa-hint" slot="fallback">Warming up the WordArt machine…</p>
		</Studio>
	</main>
</Layout>
