---
import Layout from '../../layouts/Layout.astro'
import { Badge, Flex, Link, Text } from '@mrmartineau/zui/astro'

export const title = 'Pure CSS icons'
export const description = 'A 2010 study in drawing icons with nothing but div, span, border-radius and transform. No SVG, no images.'
export const date = '2010-08-01'
export const status = 'archived'
export const tags = ['css']
---

<Layout title="Pure CSS icons — lab.zander.wtf">
	<main class="page">
		<header class="flow">
			<Link href="/">← All lab items</Link>
			<Flex align="center" gap="sm">
				<h1>Pure CSS icons</h1>
				<Badge variant="fill" color="gray">archived</Badge>
			</Flex>
			<Text size="1">{description}</Text>
		</header>

		<div class="flex gap-md">
			<div class="wrapper" style="font-size:12px;">
				<h3>RSS (without border)</h3>
				<div id="rss_icon_main" class="outside gap">
						<a href="http://rathersplendid.net"><span class="outer_ring"></span>
						<span class="middle_ring"></span>
