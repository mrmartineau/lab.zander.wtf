---
import Lab from '../../components/json-render/Lab.tsx'
import Layout from '../../layouts/Layout.astro'
import { Link } from '@mrmartineau/zui/astro'

export const title = 'json-render playground'
export const description = 'A fake AI chat that streams json-render specs into ZUI components.'
export const date = '2026-09-24'
export const status = 'wip'
export const tags = ['ai', 'zui', 'json-render']
---

<Layout title="json-render playground — lab.zander.wtf">
	<main class="page flow">
		<header class="flow">
			<Link href="/">← All lab items</Link>
			<h1 class="zui-text-4">json-render playground</h1>
			<p class="zui-color-muted">
				A fake chat. No model — canned replies stream as real
				<Link href="https://github.com/vercel-labs/json-render">json-render</Link> JSONL patches and render
				with ZUI components. Click a reply to inspect it.
			</p>
		</header>
		<Lab client:only="react" />
	</main>
</Layout>

<style is:global>
	.page {
		max-width: 80rem;
		margin-inline: auto;
		padding: var(--space-md);
	}
	.jr-lab {
		display: grid;
		gap: var(--space-md);
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
		align-items: start;
	}
	@media (width < 56rem) {
		.jr-lab {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.jr-chat {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		height: 75dvh;
	}
	.jr-log {
		flex: 1;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		padding: var(--space-xs);
		border: 1px var(--border-style) var(--color-border);
		border-radius: var(--radius-lg);
	}
	.jr-empty {
		margin: auto;
		text-align: center;
		max-width: 28rem;
	}
	.jr-msg {
		border-radius: var(--radius-lg);
		padding: var(--space-xs) var(--space-sm);
	}
	.jr-msg-user {
		align-self: flex-end;
		max-width: 80%;
		background: var(--color-theme);
		color: var(--color-background);
	}
	.jr-msg-ai {
		align-self: stretch;
		cursor: pointer;
		outline: 1px var(--border-style) transparent;
		transition: outline-color 0.2s var(--ease);
	}
	.jr-msg-ai.is-selected {
		outline-color: var(--color-border);
		background: var(--color-surface);
	}
	.jr-dots::after {
		content: '●●●';
		letter-spacing: var(--space-3xs);
		animation: var(--animation-pulse);
	}
	.jr-suggestions {
		overflow-x: auto;
		padding-block: var(--space-3xs);
	}
	.jr-suggestions .zui-button {
		flex: none;
	}
	.jr-inspector {
		position: sticky;
		top: var(--space-md);
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}
	.jr-pre {
		max-height: 65dvh;
		overflow: auto;
		font-size: var(--step--2);
		white-space: pre-wrap;
		word-break: break-word;
	}
	/* Catalog component helpers */
	.jr-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(var(--jr-min), 100%), 1fr));
	}
	.jr-stat {
		display: flex;
		flex-direction: column;
		gap: var(--space-3xs);
	}
	.jr-trend-up {
		color: var(--color-success);
	}
	.jr-trend-down {
		color: var(--color-error);
	}
	.jr-progress {
		width: 100%;
		accent-color: var(--color-theme);
	}
	.jr-toast {
		position: fixed;
		bottom: var(--space-md);
		left: 50%;
		translate: -50% 0;
		z-index: var(--z-9);
		padding: var(--space-xs) var(--space-md);
		border-radius: var(--radius-full);
		background: var(--color-text);
		color: var(--color-background);
		box-shadow: var(--shadow-lg);
		animation: var(--animation-slide-in-up);
	}
</style>
