<style is:global>
  /* Global: the script builds text boxes, so scoped styles would miss them. */
  .texts { position: absolute; inset: 0; pointer-events: none; }
  .text-box { position: absolute; font-weight: 700; line-height: 1.2; }
  .text-body { padding: var(--space-4xs) var(--space-3xs); white-space: pre; outline: none; min-width: 1ch; }
  /* Handles sit flush on the box's top-left corner, lined up with its outline. */
  .text-handles { position: absolute; left: -2px; bottom: calc(100% + 2px); display: none; }
  .text-handle {
    width: 28px; height: 28px; display: grid; place-items: center; padding: 0;
    border: var(--border-style) 2px var(--color-border); background: var(--color-surface); color: var(--color-text);
    font-size: var(--step-0); line-height: 1; cursor: pointer;
  }
  .text-handle i { display: block; }
  .text-handle + .text-handle { margin-inline-start: -2px; }
  .text-move { cursor: grab; touch-action: none; }
  .text-move:active { cursor: grabbing; }
  .text-delete:hover { background: var(--color-error); color: var(--color-white); }
  #stage[data-mode=text] .text-box { pointer-events: auto; }
  #stage[data-mode=text] .text-body { outline: 2px dashed var(--color-gray-500); }
  #stage[data-mode=text] .text-body:focus { outline: var(--border-style) 2px var(--color-accent); }
  #stage[data-mode=text] .text-handles { display: flex; }

