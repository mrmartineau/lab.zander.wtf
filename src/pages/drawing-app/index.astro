---
import Layout from '../../layouts/Layout.astro'
import { Button, Dialog, DialogBody, DialogHeader, DialogTitle, Field, Input, Label, Menu, MenuContent, MenuItem, MenuTrigger, Tooltip } from '@mrmartineau/zui/astro'

// Lab item metadata — read by the homepage listing.
export const title = 'Drawing app'
export const description = 'Kid-friendly drawing app built with p5.js — magic brushes, neon and ribbon pens, paint-bucket fill, editable vector shapes with SVG export, colouring pages, text, stickers and snowflake mirrors.'
export const date = '2026-05-19'
export const status = 'live'
export const tags = ['drawing', 'p5.js']

// key: the letter that picks the tool (number keys pick magic brushes).
type Tool = { mode: string; name: string; icon: string; desc: string; key?: string }

const magic: Tool[] = [
  { mode: 'trails', name: 'Trails', icon: 'ph-sparkle', desc: 'Rainbow dots that wobble as you move.' },
  { mode: 'splatter', name: 'Splatter', icon: 'ph-drop', desc: 'Paint flicks out from the brush.' },
  { mode: 'spirograph', name: 'Spirograph', icon: 'ph-spiral', desc: 'Loops spin round while you hold.' },
  { mode: 'bubbles', name: 'Bubbles', icon: 'ph-circles-three', desc: 'Soft see-through bubbles.' },
  { mode: 'lightning', name: 'Lightning', icon: 'ph-lightning', desc: 'Crackles of light while you hold.' },
  { mode: 'glitter', name: 'Glitter', icon: 'ph-star-four', desc: 'Twinkly sparkles in every colour.' },
  { mode: 'grass', name: 'Grass', icon: 'ph-plant', desc: 'Little blades grow as you drag.' },
]
const pens: Tool[] = [
  { mode: 'pen', key: 'p', name: 'Pen', icon: 'ph-pen-nib', desc: 'Lines. Slow is thick, fast is thin.' },
  { mode: 'neon', key: 'n', name: 'Neon', icon: 'ph-lightbulb', desc: 'A glowing pen, like a light-up sign.' },
  { mode: 'ribbon', name: 'Ribbon', icon: 'ph-wave-sine', desc: 'A rainbow ribbon follows you.' },
  { mode: 'text', key: 't', name: 'Text', icon: 'ph-text-t', desc: 'Tap the page to type. Drag the handles to move or turn it.' },
  { mode: 'fill', key: 'f', name: 'Fill', icon: 'ph-paint-bucket', desc: 'Tap a space to fill it with colour.' },
  { mode: 'eraser', key: 'e', name: 'Eraser', icon: 'ph-eraser', desc: 'Rubs out back to the paper.' },
]
const shapes: Tool[] = [
  { mode: 'circle', name: 'Circle', icon: 'ph-circle', desc: 'Drag to stamp circles. Speed packs them closer.' },
  { mode: 'square', name: 'Square', icon: 'ph-square', desc: 'Drag to stamp squares. Speed packs them closer.' },
  { mode: 'triangle', name: 'Triangle', icon: 'ph-triangle', desc: 'Drag to stamp triangles. Speed packs them closer.' },
  { mode: 'star', name: 'Star', icon: 'ph-star', desc: 'Drag to stamp stars. Speed packs them closer.' },
  { mode: 'heart', name: 'Heart', icon: 'ph-heart', desc: 'Drag to stamp hearts. Speed packs them closer.' },
]
const vectors: Tool[] = [
  { mode: 'v-select', key: 'v', name: 'Select', icon: 'ph-cursor', desc: 'Tap a shape to pick it. Drag to move it, pull the dots to stretch it, spin it with the top dot. Double-tap to edit its points.' },
  { mode: 'v-line', key: 'l', name: 'Line', icon: 'ph-line-segment', desc: 'Drag a straight line. Hold Shift to snap the angle.' },
  { mode: 'v-rect', key: 'r', name: 'Box', icon: 'ph-rectangle', desc: 'Drag a box. Hold Shift for a square.' },
  { mode: 'v-oval', key: 'o', name: 'Oval', icon: 'ph-circle-dashed', desc: 'Drag an oval. Hold Shift for a circle.' },
  { mode: 'v-curve', key: 'c', name: 'Curve', icon: 'ph-bezier-curve', desc: 'Draw a smooth line you can move and stretch later.' },
]
const stamp: Tool ={ mode: 'emoji', key: 's', name: 'Stickers', icon: 'ph-stamp', desc: 'Drag to stamp stickers. Speed packs them closer.' }
const stickers = ['🌈', '🐱', '🚀', '🦄', '🌟', '🌸', '🐶', '🦋', '❤️', '🦖', '🐠', '🍕', '🍩', '🌻', '🐝', '👑', '🎈', '⚽']
const withKey = (t: Tool) => (t.key ? `${t.name} (${t.key.toUpperCase()})` : t.name)
const colours = ['#ffffff', '#ff4d6d', '#ff9f1c', '#ffd60a', '#52d273', '#2ec4f1', '#4d7cff', '#a66cff', '#ff7ac6', '#8b5a2b', '#1a1a1a']
const mirrors = [
  { v: 'off', icon: 'ph-prohibit', name: 'Off' },
  { v: 'lr', icon: 'ph-flip-horizontal', name: 'Butterfly' },
  { v: 'four', icon: 'ph-plus', name: 'Four ways' },
  { v: 'k6', icon: 'ph-snowflake', name: 'Snowflake' },
]
const colouringPages = [
  { v: 'fish', emoji: '🐟', name: 'Fish' },
  { v: 'flower', emoji: '🌸', name: 'Flower' },
  { v: 'house', emoji: '🏠', name: 'House' },
  { v: 'rocket', emoji: '🚀', name: 'Rocket' },
  { v: 'cat', emoji: '🐱', name: 'Cat' },
  { v: 'butterfly', emoji: '🦋', name: 'Butterfly' },
]
const fonts = [
  { v: 'rounded', name: 'Round', css: 'ui-rounded, "Arial Rounded MT Bold", "Nunito", system-ui, sans-serif' },
  { v: 'hand', name: 'Comic', css: '"Comic Sans MS", "Chalkboard SE", "Comic Neue", cursive' },
  { v: 'serif', name: 'Story', css: 'Georgia, "Times New Roman", serif' },
  { v: 'mono', name: 'Robot', css: 'ui-monospace, "Courier New", monospace' },
]
const papers = [
  { c: '#141414', name: 'Night' },
  { c: '#ffffff', name: 'White' },
  { c: '#fff4d6', name: 'Cream' },
  { c: '#cdeefd', name: 'Sky' },
]
---
<Layout title="Drawing app — lab.zander.wtf" lockZoom>
<div class="app">
  <header class="bar">
    <div class="group" aria-label="Magic brushes">
      {magic.map((t, i) => (
        <Tooltip text={`${t.name} (${i + 1})`} placement="bottom"><button class="tool" data-mode={t.mode} data-desc={t.desc} data-name={t.name} aria-label={t.name} aria-pressed={i === 0 ? 'true' : 'false'}><i class={`ph ${t.icon}`}></i></button></Tooltip>
      ))}
    </div>
    <div class="group" aria-label="Pens">
      {pens.map((t) => (
        <Tooltip text={withKey(t)} placement="bottom"><button class="tool" data-key={t.key} data-mode={t.mode} data-desc={t.desc} data-name={t.name} aria-label={t.name} aria-pressed="false"><i class={`ph ${t.icon}`}></i></button></Tooltip>
      ))}
    </div>
    <div class="group" aria-label="Vector shapes">
      {vectors.map((t) => (
        <Tooltip text={withKey(t)} placement="bottom"><button class="tool" data-key={t.key} data-mode={t.mode} data-desc={t.desc} data-name={t.name} aria-label={t.name} aria-pressed="false"><i class={`ph ${t.icon}`}></i></button></Tooltip>
      ))}
    </div>
    <div class="group" aria-label="Shapes and stickers">
      <Menu id="shape-menu">
        <Tooltip text="Shapes (H)" placement="bottom">
        <MenuTrigger class="tool menu-trigger" id="shape-trigger" data-mode={shapes[0].mode} data-desc={shapes[0].desc} data-name={shapes[0].name} aria-label="Shapes">
          <i class={`ph ${shapes[0].icon}`}></i><i class="ph ph-caret-down caret" aria-hidden="true"></i>
        </MenuTrigger>
        </Tooltip>
        <MenuContent class="menu-list">
          {shapes.map((t, i) => (
            <MenuItem class="menu-item shape-item" data-shape={t.mode} data-desc={t.desc} data-name={t.name} data-icon={t.icon} data-current={i === 0 ? 'true' : undefined}>
              <i class={`ph ${t.icon}`}></i>{t.name}
            </MenuItem>
          ))}
        </MenuContent>
      </Menu>
      <Tooltip text={withKey(stamp)} placement="bottom"><button class="tool" data-key={stamp.key} data-mode={stamp.mode} data-desc={stamp.desc} data-name={stamp.name} aria-label={stamp.name} aria-pressed="false"><i class={`ph ${stamp.icon}`}></i></button></Tooltip>
    </div>
    <div class="group" aria-label="Page">
      <Menu id="mirror-menu">
        <Tooltip text="Mirror" placement="bottom">
          <MenuTrigger class="tool menu-trigger" id="mirror-trigger" aria-label="Mirror">
            <i class="ph ph-flip-horizontal"></i><i class="ph ph-caret-down caret" aria-hidden="true"></i>
          </MenuTrigger>
        </Tooltip>
        <MenuContent class="menu-list">
          {mirrors.map((m, i) => (
            <MenuItem class="menu-item" data-sym={m.v} data-current={i === 0 ? 'true' : undefined}>
              <i class={`ph ${m.icon}`}></i>{m.name}
            </MenuItem>
          ))}
        </MenuContent>
      </Menu>
      <Menu id="page-menu">
        <Tooltip text="Colouring pages" placement="bottom">
          <MenuTrigger class="tool menu-trigger" aria-label="Colouring pages">
            <i class="ph ph-book-open"></i><i class="ph ph-caret-down caret" aria-hidden="true"></i>
          </MenuTrigger>
        </Tooltip>
        <MenuContent class="menu-list">
          {colouringPages.map((pg) => (
            <MenuItem class="menu-item" data-page={pg.v}>
              <span class="menu-emoji">{pg.emoji}</span>{pg.name}
            </MenuItem>
          ))}
        </MenuContent>
      </Menu>
      <Menu id="paper-menu">
        <Tooltip text="New paper" placement="bottom">
          <MenuTrigger class="tool menu-trigger" aria-label="New paper">
            <i class="ph ph-file-plus"></i><i class="ph ph-caret-down caret" aria-hidden="true"></i>
          </MenuTrigger>
        </Tooltip>
        <MenuContent class="menu-list">
          {papers.map((pp) => (
            <MenuItem class="menu-item" data-paper={pp.c}>
              <span class="menu-paper" style={`--c:${pp.c}`}></span>{pp.name}
            </MenuItem>
          ))}
        </MenuContent>
      </Menu>
    </div>
    <span class="spacer"></span>
    <Tooltip text="Pick a surprise tool" placement="bottom"><button class="act" data-action="surprise"><i class="ph ph-dice-five"></i><span>Surprise!</span></button></Tooltip>
    <Tooltip text="My drawings (⌘S)" placement="bottom"><button class="act" data-action="drawings"><i class="ph ph-folder-open"></i><span>My drawings</span></button></Tooltip>
    <Tooltip text="Undo (⌘Z)" placement="bottom"><button class="act" data-action="undo"><i class="ph ph-arrow-counter-clockwise"></i><span>Undo</span></button></Tooltip>
    <Tooltip text="Clear the page" placement="bottom"><button class="act" data-action="clear"><i class="ph ph-trash"></i><span>Clear</span></button></Tooltip>
    <Tooltip text="Save as a picture" placement="bottom"><button class="act primary" data-action="save"><i class="ph ph-download-simple"></i><span>Save</span></button></Tooltip>
  </header>

  <div class="main">
    <div class="stage" id="stage">
      <canvas id="c"></canvas>
      <canvas id="lines" aria-hidden="true"></canvas>
      <div class="guides" id="guides" data-sym="off" aria-hidden="true"></div>
      <svg class="vectors" id="vectors" aria-hidden="true"></svg>
      <div class="texts" id="texts"></div>
    </div>

    <aside class="panel" aria-label="Tool settings">
      <div class="head">
        <span class="head-icon"><i class="ph ph-sparkle" id="tool-icon"></i></span>
        <div>
          <h2 id="tool-name">Trails</h2>
          <p id="tool-desc">Rainbow dots that wobble as you move.</p>
        </div>
      </div>

      <section class="field" data-for="fx pen eraser shape emoji text vector">
        <label for="size"><span id="size-name">Size</span> <output id="size-v">12</output></label>
        <input type="range" id="size" min="2" max="40" value="12">
      </section>
      <section class="field" data-for="fx shape emoji">
        <label for="speed">Speed <output id="speed-v">5</output></label>
        <input type="range" id="speed" min="1" max="10" value="5">
      </section>
      <section class="field" data-for="pen eraser">
        <label for="wobble">Line <output id="wobble-v">Smooth</output></label>
        <input type="range" id="wobble" min="0" max="10" value="3">
        <div class="range-ends" aria-hidden="true"><span>Smooth</span><span>Jittery</span></div>
      </section>
      <section class="field" data-for="fx">
        <span class="label">Colour</span>
        <div class="row">
          <span class="rainbow"></span>
          <span class="hint">Magic colours — they change by themselves</span>
          <button class="small" data-action="shuffle" aria-label="Jump to new colours" title="Jump to new colours"><i class="ph ph-shuffle"></i></button>
        </div>
      </section>
      <section class="field" data-for="pen shape fill text vector">
        <span class="label" id="colour-label">Colour</span>
        <div class="swatches" role="radiogroup" aria-labelledby="colour-label">
          <button class="swatch swatch-rainbow" role="radio" aria-checked="false" data-colour="rainbow" aria-label="Rainbow"></button>
          {colours.map((c, i) => (
            <button class="swatch" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-colour={c} style={`--c:${c}`} aria-label={c}></button>
          ))}
          <label class="swatch swatch-custom" title="Any colour">
            <input type="color" id="custom-colour" value="#ffffff" aria-label="Any colour">
            <i class="ph ph-plus" aria-hidden="true"></i>
          </label>
        </div>
      </section>
      <section class="field" data-for="text">
        <span class="label" id="font-label">Letters</span>
        <div class="choices" role="radiogroup" aria-labelledby="font-label">
          {fonts.map((f, i) => (
            <button class="choice font" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-font={f.css} style={`font-family:${f.css}`}>{f.name}</button>
          ))}
        </div>
        <p class="hint">Changes the text you are typing, and any new text.</p>
      </section>
      <section class="field" data-for="vector" id="corner-field">
        <label for="corner">Corners <output id="corner-v">0</output></label>
        <input type="range" id="corner" min="0" max="60" value="0">
        <div class="range-ends" aria-hidden="true"><span>Sharp</span><span>Round</span></div>
      </section>
      <section class="field" data-for="vector">
        <span class="label" id="vfill-label">Inside</span>
        <div class="choices" role="radiogroup" aria-labelledby="vfill-label">
          <button class="choice vfill" role="radio" aria-checked="true" data-fill=""><i class="ph ph-square"></i>Empty</button>
          <button class="choice vfill" role="radio" aria-checked="false" data-fill="1"><i class="ph ph-paint-bucket"></i>Filled</button>
        </div>
        <div class="field" id="fill-alpha-field" hidden>
          <label for="fill-alpha">Fill strength <output id="fill-alpha-v">50%</output></label>
          <input type="range" id="fill-alpha" min="10" max="100" step="5" value="50">
          <div class="range-ends" aria-hidden="true"><span>See-through</span><span>Solid</span></div>
        </div>
      </section>
      <section class="field" data-for="vector">
        <span class="label">Shapes</span>
        <p class="hint">Shapes stay editable. Pick one with Select (V) to move, stretch, turn, recolour or delete it. Double-tap it, or press Edit points or Enter, to drag its points and bend its sides.</p>
        <div class="choices">
          <button class="choice" data-action="vpoints" id="v-points" aria-pressed="false" disabled><i class="ph ph-bezier-curve"></i>Edit points</button>
          <button class="choice" data-action="vdelete" id="v-delete" disabled><i class="ph ph-trash"></i>Delete</button>
          <button class="choice" data-action="svg"><i class="ph ph-file-svg"></i>Save SVG</button>
        </div>
      </section>
      <section class="field" data-for="emoji">
        <span class="label">Sticker</span>
        <div class="stickers">
          {stickers.map((e, i) => <button class="sticker" data-sticker={e} aria-pressed={i === 4 ? 'true' : 'false'}>{e}</button>)}
        </div>
      </section>

    </aside>
  </div>
</div>

<Dialog id="drawings" size="md" aria-labelledby="drawings-title">
  <DialogHeader class="drawings-head">
    <DialogTitle id="drawings-title"><i class="ph ph-folder-open"></i> My drawings</DialogTitle>
    <button class="small" data-action="closeDrawings" aria-label="Close"><i class="ph ph-x"></i></button>
  </DialogHeader>
  <DialogBody class="drawings-body">
    <form id="drawing-save" class="drawing-save">
      <Field>
        <Label for="drawing-name">Name</Label>
        <Input id="drawing-name" maxlength="60" placeholder="My picture" autocomplete="off" />
      </Field>
      <Button type="submit" size="sm"><i class="ph ph-floppy-disk"></i> Save</Button>
    </form>
    <p class="hint">Saved in this browser. Saving with the same name replaces it. Opening one can be undone.</p>
    <p class="drawings-msg" id="drawings-msg" role="status"></p>
    <ul class="drawings-list" id="drawings-list"></ul>
  </DialogBody>
</Dialog>
</Layout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.4/p5.min.js"></script>
<script is:inline>
let mode = 'trails';
let brushSize = 12;
let speed = 5;
let wobble = 3; // pen line: 0 very smooth, 5 raw pointer, 10 very jittery
let hue = Math.random() * 360;
let penColour = '#ffffff';
let rainbowPen = false;
let bgColour = '#141414';
let currentEmoji = '🌟';
let symMode = 'off'; // 'off' | 'lr' | 'four' | 'k6'
let page = null; // colouring page drawn on the lines layer, if any
let p5Instance;
let isDrawing = false;
let prevX, prevY;
let t = 0;
const undoStack = [];
const shapeModes = ['circle', 'square', 'triangle', 'star', 'heart'];
const fxModes = ['trails', 'splatter', 'spirograph', 'bubbles', 'lightning', 'glitter', 'grass', 'ribbon'];

const $ = (s) => document.querySelector(s);
const $$ = (s) => [...document.querySelectorAll(s)];
const stage = $('#stage');
const shapeTrigger = $('#shape-trigger');
const mirrorTrigger = $('#mirror-trigger');
const textLayer = $('#texts');
const linesCanvas = $('#lines');

// ---------- Colouring pages ----------
// Line art lives on its own canvas above the paint, so brushes never cover
// the lines and the fill tool can use them as walls.
// Each picture is drawn in a 100×100 box. `shape` hides any lines under it
// (so later parts sit on top) and outlines it; `line` only outlines.
const PAGES = {
  fish(shape, line) {
    shape(poly([[22, 50], [6, 34], [6, 66]]));
    shape(poly([[40, 34], [52, 20], [62, 33]]));
    shape(ellipse(50, 50, 32, 20));
    line(arc(48, 50, 12, -0.8, 0.8));
    shape(circle(70, 45, 4));
    shape(circle(71, 45, 1.6));
    shape(circle(84, 30, 3));
    shape(circle(90, 20, 2.2));
    shape(circle(86, 12, 1.6));
    shape(poly([[8, 96], [14, 76], [20, 96]]));
    shape(poly([[86, 96], [92, 72], [96, 96]]));
  },
  flower(shape) {
    shape(circle(86, 14, 8));
    shape(ellipse(39, 76, 11, 4.5, -0.5));
    shape(ellipse(61, 68, 11, 4.5, 0.5));
    shape(rect(48.5, 46, 3, 50));
    for (let k = 0; k < 8; k++) {
      const a = (Math.PI / 4) * k;
      shape(ellipse(50 + Math.cos(a) * 17, 34 + Math.sin(a) * 17, 10, 6, a));
    }
    shape(circle(50, 34, 9));
  },
  house(shape, line) {
    shape(circle(86, 14, 8));
    shape(rect(64, 20, 8, 18));
    shape(poly([[16, 46], [50, 18], [84, 46]]));
    shape(rect(24, 46, 52, 42));
    shape(rect(44, 63, 12, 25));
    shape(circle(53, 76, 1.2));
    for (const x of [30, 60]) {
      shape(rect(x, 52, 10, 10));
      line(poly([[x + 5, 52], [x + 5, 62]], false));
      line(poly([[x, 57], [x + 10, 57]], false));
    }
    line(poly([[2, 88], [98, 88]], false));
  },
  rocket(shape) {
    shape(poly([[42, 79], [50, 96], [58, 79]]));
    shape(poly([[38, 56], [24, 82], [40, 76]]));
    shape(poly([[62, 56], [76, 82], [60, 76]]));
    const body = new Path2D();
    body.moveTo(50, 8);
    body.quadraticCurveTo(68, 28, 62, 79);
    body.lineTo(38, 79);
    body.quadraticCurveTo(32, 28, 50, 8);
    shape(body);
    shape(circle(50, 40, 7));
    shape(rect(40, 62, 20, 4));
    shape(star(14, 18, 5));
    shape(star(86, 30, 4));
    shape(star(18, 62, 3.5));
    shape(star(84, 70, 5));
  },
  cat(shape, line) {
    shape(ellipse(50, 84, 26, 14));
    shape(poly([[28, 32], [30, 8], [46, 22]]));
    shape(poly([[72, 32], [70, 8], [54, 22]]));
    shape(ellipse(50, 46, 28, 25));
    shape(ellipse(39, 41, 5, 6.5));
    shape(ellipse(61, 41, 5, 6.5));
    shape(ellipse(39, 42, 1.8, 4));
    shape(ellipse(61, 42, 1.8, 4));
    shape(poly([[47, 52], [53, 52], [50, 56]]));
    const mouth = new Path2D();
    mouth.moveTo(50, 56); mouth.quadraticCurveTo(46, 62, 42, 58);
    mouth.moveTo(50, 56); mouth.quadraticCurveTo(54, 62, 58, 58);
    line(mouth);
    for (const [y, dy] of [[52, -3], [55, 0], [58, 3]]) {
      line(poly([[34, y], [14, y + dy]], false));
      line(poly([[66, y], [86, y + dy]], false));
    }
  },
  butterfly(shape, line) {
    shape(ellipse(31, 34, 19, 15, -0.4));
    shape(ellipse(69, 34, 19, 15, 0.4));
    shape(ellipse(35, 63, 13, 11, 0.4));
    shape(ellipse(65, 63, 13, 11, -0.4));
    for (const [x, y, r] of [[28, 32, 5], [72, 32, 5], [35, 64, 3.5], [65, 64, 3.5]]) shape(circle(x, y, r));
    shape(ellipse(50, 50, 4, 24));
    const feelers = new Path2D();
    feelers.moveTo(49, 27); feelers.quadraticCurveTo(44, 16, 38, 12);
    feelers.moveTo(51, 27); feelers.quadraticCurveTo(56, 16, 62, 12);
    line(feelers);
    shape(circle(38, 12, 2));
    shape(circle(62, 12, 2));
  },
};

function circle(x, y, r) { const p = new Path2D(); p.arc(x, y, r, 0, Math.PI * 2); return p; }
function ellipse(x, y, rx, ry, rot = 0) { const p = new Path2D(); p.ellipse(x, y, rx, ry, rot, 0, Math.PI * 2); return p; }
function rect(x, y, w, h) { const p = new Path2D(); p.rect(x, y, w, h); return p; }
function arc(x, y, r, a0, a1) { const p = new Path2D(); p.arc(x, y, r, a0, a1); return p; }
function poly(pts, closed = true) {
  const p = new Path2D();
  pts.forEach(([x, y], i) => (i ? p.lineTo(x, y) : p.moveTo(x, y)));
  if (closed) p.closePath();
  return p;
}
function star(x, y, r) {
  const pts = [];
  for (let i = 0; i < 10; i++) {
    const a = (Math.PI * i) / 5 - Math.PI / 2, rr = i % 2 ? r * 0.45 : r;
    pts.push([x + Math.cos(a) * rr, y + Math.sin(a) * rr]);
  }
  return poly(pts);
}

// The picture box is fixed when the page is picked, so a resize keeps the
// lines lined up with the paint (which stays anchored top-left).
let pageBox = null;
function drawLines() {
  if (!p5Instance) return;
  const pd = p5Instance.pixelDensity();
  const W = p5Instance.width, H = p5Instance.height;
  linesCanvas.width = W * pd;
  linesCanvas.height = H * pd;
  const ctx = linesCanvas.getContext('2d');
  ctx.clearRect(0, 0, linesCanvas.width, linesCanvas.height);
  if (!page) return;
  if (!pageBox) {
    const s = Math.min(W, H) * 0.88;
    pageBox = { x: (W - s) / 2, y: (H - s) / 2, s };
  }
  const k = pageBox.s / 100;
  ctx.setTransform(pd * k, 0, 0, pd * k, pd * pageBox.x, pd * pageBox.y);
  ctx.lineWidth = Math.max(3, pageBox.s / 140) / k;
  ctx.lineJoin = ctx.lineCap = 'round';
  ctx.strokeStyle = '#111';
  const shape = (path) => {
    ctx.globalCompositeOperation = 'destination-out';
    ctx.fill(path);
    ctx.globalCompositeOperation = 'source-over';
    ctx.stroke(path);
  };
  const line = (path) => ctx.stroke(path);
  PAGES[page](shape, line);
}

function setPage(name) {
  page = name;
  pageBox = null;
  drawLines();
}

// ---------- Actions ----------
function setMode(m) {
  if (mode === 'text' && m !== 'text') document.activeElement?.closest('.text-box') && document.activeElement.blur();
  if (m !== 'v-select' && selected) select(null);
  mode = m;
  stage.dataset.mode = m;
  pruneEmptyTexts();
  $$('.tool:not(.menu-trigger)').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
  shapeTrigger.dataset.active = String(shapeModes.includes(m));
  syncPanel();
}

// ---------- Text boxes ----------
// Text sits in DOM boxes above the canvas so it stays editable and movable.
// Boxes only take the pointer in text mode, so brushes still reach the
// canvas underneath. Save draws them onto the picture.
let textFont = $('.font').dataset.font;
let activeBox = null;
const textSize = () => brushSize * 3;
const cssColour = () => (rainbowPen ? `hsl(${hue} 85% 55%)` : penColour);

function makeTextBox({ x, y, text = '', size, colour, font, rot = 0 }) {
  const box = document.createElement('div');
  box.className = 'text-box';
  box.innerHTML = `
    <div class="text-body" contenteditable="plaintext-only" spellcheck="false" aria-label="Text"></div>
    <div class="text-handles">
      <button class="text-handle text-move" aria-label="Move text"><i class="ph ph-arrows-out-cardinal"></i></button>
      <button class="text-handle text-spin" aria-label="Turn text"><i class="ph ph-arrow-clockwise"></i></button>
      <button class="text-handle text-delete" aria-label="Delete text"><i class="ph ph-x"></i></button>
    </div>`;
  const body = box.querySelector('.text-body');
  body.textContent = text;
  Object.assign(box.dataset, { x, y, size, colour, font, rot });
  styleBox(box);
  body.addEventListener('focus', () => (activeBox = box));
  body.addEventListener('blur', () => {
    if (!body.textContent.trim()) box.remove();
  });
  box.querySelector('.text-delete').addEventListener('click', () => {
    pushHistory();
    box.remove();
  });
  dragWith(box.querySelector('.text-move'), box);
  spinWith(box.querySelector('.text-spin'), box);
  textLayer.append(box);
  return box;
}

function styleBox(box) {
  const { x, y, size, colour, font, rot } = box.dataset;
  Object.assign(box.style, { left: x + 'px', top: y + 'px', fontSize: size + 'px', color: colour, fontFamily: font, rotate: rot + 'deg' });
}

// Turn a box round its middle by dragging its handle. Shift snaps to 15° steps.
function spinWith(handle, box) {
  handle.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    handle.setPointerCapture(e.pointerId);
    pushHistory();
    const r = box.getBoundingClientRect(), cx = r.left + r.width / 2, cy = r.top + r.height / 2;
    const angle = (ev) => (Math.atan2(ev.clientY - cy, ev.clientX - cx) * 180) / Math.PI;
    const a0 = angle(e), rot0 = +box.dataset.rot;
    const move = (ev) => {
      const a = rot0 + angle(ev) - a0;
      box.dataset.rot = Math.round(ev.shiftKey ? Math.round(a / 15) * 15 : a);
      styleBox(box);
    };
    const end = () => {
      handle.removeEventListener('pointermove', move);
      handle.removeEventListener('pointerup', end);
      handle.removeEventListener('pointercancel', end);
    };
    handle.addEventListener('pointermove', move);
    handle.addEventListener('pointerup', end);
    handle.addEventListener('pointercancel', end);
  });
}

// Move a box by dragging its handle, kept inside the stage.
function dragWith(handle, box) {
  handle.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    handle.setPointerCapture(e.pointerId);
    const startX = e.clientX, startY = e.clientY, x0 = +box.dataset.x, y0 = +box.dataset.y;
    const move = (ev) => {
      box.dataset.x = Math.round(Math.min(Math.max(x0 + ev.clientX - startX, 0), stage.clientWidth - 24));
      box.dataset.y = Math.round(Math.min(Math.max(y0 + ev.clientY - startY, 0), stage.clientHeight - 24));
      styleBox(box);
    };
    const end = () => {
      handle.removeEventListener('pointermove', move);
      handle.removeEventListener('pointerup', end);
      handle.removeEventListener('pointercancel', end);
    };
    handle.addEventListener('pointermove', move);
    handle.addEventListener('pointerup', end);
    handle.addEventListener('pointercancel', end);
  });
}

// Drop boxes left empty (backs up the blur check, which a lost window focus skips).
function pruneEmptyTexts() {
  textBoxes().forEach((b) => {
    const body = b.querySelector('.text-body');
    if (body !== document.activeElement && !body.textContent.trim()) b.remove();
  });
}

function addTextAt(x, y) {
  pruneEmptyTexts();
  pushHistory();
  const size = textSize();
  const box = makeTextBox({ x: Math.round(x), y: Math.round(y - size * 0.7), size, colour: cssColour(), font: textFont });
  setTimeout(() => box.querySelector('.text-body').focus());
}

// Change the box being typed in (if any) when a text setting changes.
function updateActiveBox(props) {
  if (mode !== 'text' || !activeBox?.isConnected) return;
  Object.assign(activeBox.dataset, props);
  styleBox(activeBox);
}

const textBoxes = () => $$('.text-box');
const readTexts = () => textBoxes().map((b) => ({ ...b.dataset, text: b.querySelector('.text-body').textContent }));
function restoreTexts(list) {
  textBoxes().forEach((b) => b.remove());
  list.forEach((t) => makeTextBox(t));
}

// ---------- Vector shapes ----------
// Vector shapes live as data and render into an SVG layer above the paint, so
// they stay editable: Select moves them, the end dots stretch them. Each shape
// keeps two points (x1,y1)–(x2,y2): a line's ends, or a box's corners. A curve
// keeps its points as 0–1 fractions of that box, so stretching the box
// stretches the curve. Editing points turns any shape into a `path`: nodes
// joined by sides, each side straight or bent by one control point, all
// stored as fractions of the box too. Save draws them onto the picture.
const SVGNS = 'http://www.w3.org/2000/svg';
const vecLayer = $('#vectors');
let shapes = [];
let draft = []; // the shape being drawn, plus its mirror copies
let selected = null;
let editing = false; // dragging points rather than the whole shape
let vecFill = false;
let vecRadius = 0;
let vecAlpha = 50; // fill strength, in %

const r1 = (n) => Math.round(n * 10) / 10;
const pt = (x, y) => `${r1(x)} ${r1(y)}`;
const isFilled = (s) => s.fill && s.type !== 'line';

// Box fractions to page points, and back.
const fromBox = (s, [u, v]) => [s.x1 + u * (s.x2 - s.x1), s.y1 + v * (s.y2 - s.y1)];

function shapePath(s) {
  const { x1, y1, x2, y2 } = s;
  if (s.type === 'line') return `M${pt(x1, y1)}L${pt(x2, y2)}`;
  if (s.type === 'path') {
    const ns = s.nodes.map((n) => fromBox(s, n)), n = ns.length;
    let d = `M${pt(...ns[0])}`;
    for (let i = 0; i < (s.closed ? n : n - 1); i++) {
      const to = pt(...ns[(i + 1) % n]);
      d += s.ctrl[i] ? `Q${pt(...fromBox(s, s.ctrl[i]))} ${to}` : `L${to}`;
    }
    return s.closed || s.fill ? d + 'Z' : d;
  }
  const l = Math.min(x1, x2), r = Math.max(x1, x2), t = Math.min(y1, y2), b = Math.max(y1, y2);
  if (s.type === 'rect') {
    const k = Math.min(s.radius || 0, (r - l) / 2, (b - t) / 2);
    if (!k) return `M${pt(l, t)}H${r1(r)}V${r1(b)}H${r1(l)}Z`;
    const a = `A${pt(k, k)} 0 0 1 `;
    return `M${pt(l + k, t)}H${r1(r - k)}${a}${pt(r, t + k)}V${r1(b - k)}${a}${pt(r - k, b)}` +
      `H${r1(l + k)}${a}${pt(l, b - k)}V${r1(t + k)}${a}${pt(l + k, t)}Z`;
  }
  if (s.type === 'oval') {
    const a = `A${pt((r - l) / 2, (b - t) / 2)} 0 1 0 `, cy = (t + b) / 2;
    return `M${pt(l, cy)}${a}${pt(r, cy)}${a}${pt(l, cy)}Z`;
  }
  // Curve: a quadratic through the midpoints between points smooths the line.
  const ps = s.pts.map(([u, v]) => [x1 + u * (x2 - x1), y1 + v * (y2 - y1)]);
  let d = `M${pt(...ps[0])}`;
  if (ps.length === 1) return d + 'h0.01'; // a dot
  for (let i = 1; i < ps.length - 1; i++) {
    const [ax, ay] = ps[i], [bx, by] = ps[i + 1];
    d += `Q${pt(ax, ay)} ${pt((ax + bx) / 2, (ay + by) / 2)}`;
  }
  d += `L${pt(...ps.at(-1))}`;
  return s.fill ? d + 'Z' : d;
}

function svgEl(tag, attrs) {
  const el = document.createElementNS(SVGNS, tag);
  for (const k in attrs) el.setAttribute(k, attrs[k]);
  return el;
}

// Shapes turn round the middle of their box by `rot` radians.
const centre = (s) => [(s.x1 + s.x2) / 2, (s.y1 + s.y2) / 2];
const deg = (a) => r1((a * 180) / Math.PI);
const turnAttr = (s) => (s.rot ? { transform: `rotate(${deg(s.rot)} ${pt(...centre(s))})` } : {});

const inkEl = (s, d = shapePath(s)) => svgEl('path', {
  d, fill: isFilled(s) ? s.colour : 'none', 'fill-opacity': (s.fillAlpha ?? 100) / 100, stroke: s.colour, 'stroke-width': s.width,
  'stroke-linecap': 'round', 'stroke-linejoin': 'round',
});

function shapeEl(s) {
  const g = svgEl('g', turnAttr(s)), d = shapePath(s);
  // A wide see-through copy makes thin lines easy to tap.
  const hit = svgEl('path', {
    d, class: 'v-hit', fill: isFilled(s) ? 'transparent' : 'none', stroke: 'transparent',
    'stroke-width': s.width + 16, 'stroke-linecap': 'round', 'pointer-events': isFilled(s) ? 'all' : 'stroke',
  });
  hit.addEventListener('pointerdown', (e) => dragShape(e, s, 0));
  g.append(inkEl(s, d), hit);
  return g;
}

function selectionEl(s) {
  const g = svgEl('g', { class: 'v-sel', ...turnAttr(s) });
  if (editing && s.type === 'path') return pointsEl(s, g);
  const pad = s.width / 2 + 4, top = Math.min(s.y1, s.y2) - pad, [cx] = centre(s);
  if (s.type !== 'line') {
    g.append(svgEl('rect', {
      class: 'v-box', x: Math.min(s.x1, s.x2) - pad, y: top,
      width: Math.abs(s.x2 - s.x1) + pad * 2, height: Math.abs(s.y2 - s.y1) + pad * 2,
    }));
  }
  // The spin dot sits on a stalk above the box.
  g.append(svgEl('line', { class: 'v-box', x1: cx, y1: top, x2: cx, y2: top - 28 }));
  const spin = svgEl('circle', { class: 'v-handle v-spin', cx, cy: top - 28, r: 9 });
  spin.addEventListener('pointerdown', (e) => spinShape(e, s));
  g.append(spin);
  for (const end of [1, 2]) {
    const h = svgEl('circle', { class: 'v-handle', cx: s['x' + end], cy: s['y' + end], r: 9 });
    h.addEventListener('pointerdown', (e) => dragShape(e, s, end));
    g.append(h);
  }
  return g;
}

// ---------- Editing points ----------
// Square dots are the points; round dashed dots sit halfway along each side
// and bend it. Double-tap a bend dot to add a point there, or a point to
// remove it.
function pointsEl(s, g) {
  const ns = s.nodes.map((n) => fromBox(s, n)), n = ns.length;
  for (let i = 0; i < (s.closed ? n : n - 1); i++) {
    const a = ns[i], b = ns[(i + 1) % n], c = s.ctrl[i] && fromBox(s, s.ctrl[i]);
    const [mx, my] = bendPoint(a, b, c);
    if (c) g.append(svgEl('path', { class: 'v-arm', d: `M${pt(...a)}L${pt(...c)}L${pt(...b)}` }));
    const h = svgEl('circle', { class: 'v-bend', cx: mx, cy: my, r: 7 });
    h.addEventListener('pointerdown', (e) => {
      if (doubleTap(`bend${i}`)) return splitSide(e, s, i);
      const [wx, wy] = toPage(s, mx, my);
      startDrag(e, s, (x, y, dx, dy) => bendSide(s, i, toLocal(s, wx + dx, wy + dy)));
    });
    g.append(h);
  }
  ns.forEach(([x, y], i) => {
    const h = svgEl('rect', { class: 'v-node', x: x - 7, y: y - 7, width: 14, height: 14 });
    h.addEventListener('pointerdown', (e) => {
      if (doubleTap(`node${i}`)) return dropNode(e, s, i);
      const [wx, wy] = toPage(s, x, y);
      startDrag(e, s, (px, py, dx, dy) => {
        const abs = absPath(s);
        abs.nodes[i] = toLocal(s, wx + dx, wy + dy);
        setPath(s, abs);
      });
    });
    g.append(h);
  });
  return g;
}

// Where a side's bend dot sits: halfway along it, on the curve if bent.
const bendPoint = (a, b, c) => (c
  ? [(a[0] + 2 * c[0] + b[0]) / 4, (a[1] + 2 * c[1] + b[1]) / 4]
  : [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2]);

// A page point in the shape's own (unturned) frame, and back. Drags add the
// pointer's move to where the dot started on the page, so a dot keeps its
// grab point even though refitting the box shifts that frame.
const toLocal = (s, x, y) => turnPt(x, y, ...centre(s), -(s.rot || 0));
const toPage = (s, x, y) => turnPt(x, y, ...centre(s), s.rot || 0);

// Two taps on the same dot within a moment.
let lastTap = { key: '', at: 0 };
function doubleTap(key) {
  const now = performance.now(), hit = lastTap.key === key && now - lastTap.at < 350;
  lastTap = hit ? { key: '', at: 0 } : { key, at: now };
  return hit;
}

// The path's points and controls in the shape's own frame.
function absPath(s) {
  return { nodes: s.nodes.map((n) => fromBox(s, n)), ctrl: s.ctrl.map((c) => c && fromBox(s, c)) };
}

// Store points given in the shape's own frame: refit the box round them and
// move it so a turned shape stays put on the page.
function setPath(s, { nodes, ctrl }) {
  const all = [...nodes, ...ctrl.filter(Boolean)];
  const xs = all.map((p) => p[0]), ys = all.map((p) => p[1]);
  const l = Math.min(...xs), r = Math.max(...xs), t = Math.min(...ys), b = Math.max(...ys);
  const [ox, oy] = centre(s), cx = (l + r) / 2, cy = (t + b) / 2;
  const [wx, wy] = turnPt(cx, cy, ox, oy, s.rot || 0);
  const w = r - l, h = b - t;
  const frac = (p) => p && [w ? (p[0] - l) / w : 0, h ? (p[1] - t) / h : 0];
  Object.assign(s, {
    x1: l + wx - cx, x2: r + wx - cx, y1: t + wy - cy, y2: b + wy - cy,
    nodes: nodes.map(frac), ctrl: ctrl.map(frac),
  });
}

// Bend side i so its middle passes through p. Near straight snaps straight.
function bendSide(s, i, p) {
  const abs = absPath(s), a = abs.nodes[i], b = abs.nodes[(i + 1) % abs.nodes.length];
  const mx = (a[0] + b[0]) / 2, my = (a[1] + b[1]) / 2;
  abs.ctrl[i] = Math.hypot(p[0] - mx, p[1] - my) < 5 ? null : [2 * p[0] - mx, 2 * p[1] - my];
  setPath(s, abs);
}

function splitSide(e, s, i) {
  e.preventDefault();
  e.stopPropagation();
  pushHistory();
  const abs = absPath(s), a = abs.nodes[i], b = abs.nodes[(i + 1) % abs.nodes.length], c = abs.ctrl[i];
  const m = bendPoint(a, b, c);
  // Halving a bent side keeps its curve: each half gets a control halfway to the old one.
  const half = (p, q) => [(p[0] + q[0]) / 2, (p[1] + q[1]) / 2];
  abs.nodes.splice(i + 1, 0, m);
  abs.ctrl.splice(i, 1, c && half(a, c), c && half(c, b));
  setPath(s, abs);
  renderVectors();
}

function dropNode(e, s, i) {
  e.preventDefault();
  e.stopPropagation();
  if (s.nodes.length <= (s.closed ? 3 : 2)) return;
  pushHistory();
  const abs = absPath(s), n = abs.nodes.length;
  abs.nodes.splice(i, 1);
  // The sides either side of the point merge into one straight side.
  if (!s.closed && i === n - 1) abs.ctrl.splice(i - 1, 1);
  else if (!s.closed && i === 0) abs.ctrl.splice(0, 1);
  else { abs.ctrl.splice(i, 1); abs.ctrl[(i - 1 + n - 1) % (n - 1)] = null; }
  setPath(s, abs);
  renderVectors();
}

// Drop points that sit on the line between their neighbours (Ramer–Douglas–Peucker).
function simplify(ps, eps = 2) {
  if (ps.length < 3) return ps;
  const [a, b] = [ps[0], ps.at(-1)], len = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;
  let far = 0, at = 0;
  for (let i = 1; i < ps.length - 1; i++) {
    const d = Math.abs((b[0] - a[0]) * (a[1] - ps[i][1]) - (a[0] - ps[i][0]) * (b[1] - a[1])) / len;
    if (d > far) { far = d; at = i; }
  }
  if (far <= eps) return [a, b];
  return [...simplify(ps.slice(0, at + 1), eps).slice(0, -1), ...simplify(ps.slice(at), eps)];
}

// Turn a shape into an editable path, in place, without moving it.
function toPath(s) {
  if (s.type === 'path') return;
  const l = Math.min(s.x1, s.x2), r = Math.max(s.x1, s.x2), t = Math.min(s.y1, s.y2), b = Math.max(s.y1, s.y2);
  let nodes, ctrl, closed = true;
  if (s.type === 'line') {
    nodes = [[s.x1, s.y1], [s.x2, s.y2]]; ctrl = [null]; closed = false;
    s.fill = false; // a line has no inside, even once bent
  } else if (s.type === 'rect') {
    const k = Math.min(s.radius || 0, (r - l) / 2, (b - t) / 2);
    if (!k) { nodes = [[l, t], [r, t], [r, b], [l, b]]; ctrl = [null, null, null, null]; }
    else {
      // Each round corner becomes a bent side.
      nodes = [[l + k, t], [r - k, t], [r, t + k], [r, b - k], [r - k, b], [l + k, b], [l, b - k], [l, t + k]];
      ctrl = [null, [r, t], null, [r, b], null, [l, b], null, [l, t]];
    }
  } else if (s.type === 'oval') {
    // Eight bent sides follow an oval closely.
    const cx = (l + r) / 2, cy = (t + b) / 2, rx = (r - l) / 2, ry = (b - t) / 2, k = 1 / Math.cos(Math.PI / 8);
    nodes = []; ctrl = [];
    for (let i = 0; i < 8; i++) {
      const a = (Math.PI / 4) * i, m = a + Math.PI / 8;
      nodes.push([cx + rx * Math.cos(a), cy + ry * Math.sin(a)]);
      ctrl.push([cx + rx * k * Math.cos(m), cy + ry * k * Math.sin(m)]);
    }
  } else {
    // A curve keeps its look: the points it bends round become controls.
    const ps = simplify(s.pts.map((p) => fromBox(s, p)));
    closed = false;
    if (ps.length < 3) { nodes = ps.length < 2 ? [ps[0], ps[0]] : ps; ctrl = [null]; }
    else {
      const mid = (i) => [(ps[i][0] + ps[i + 1][0]) / 2, (ps[i][1] + ps[i + 1][1]) / 2];
      // Same as the curve renderer: bend through each midpoint, then a straight end.
      nodes = [ps[0]]; ctrl = [];
      for (let i = 1; i < ps.length - 1; i++) {
        nodes.push(mid(i));
        ctrl.push(ps[i]);
      }
      nodes.push(ps.at(-1));
      ctrl.push(null);
    }
  }
  delete s.pts;
  delete s.radius;
  s.type = 'path';
  s.closed = closed;
  setPath(s, { nodes, ctrl });
}

function editPoints(on) {
  if (!selected) return;
  if (on && selected.type !== 'path') {
    pushHistory();
    toPath(selected);
  }
  editing = on;
  renderVectors();
}

function renderVectors() {
  vecLayer.replaceChildren(...[...shapes, ...draft].map(shapeEl));
  if (selected) vecLayer.append(selectionEl(selected));
  $('#v-delete').disabled = $('#v-points').disabled = !selected;
  $('#v-points').setAttribute('aria-pressed', String(editing && !!selected));
  syncCornerField();
}

// Corners only apply to a box: one being drawn, or one picked.
function syncCornerField() {
  $('#corner-field').hidden = kindOf(mode) !== 'vector' || !(mode === 'v-rect' || selected?.type === 'rect');
}

function select(s) {
  if (s !== selected) editing = false;
  selected = s;
  if (s) {
    // Show the picked shape's settings in the panel.
    brushSize = s.width;
    $('#size').value = s.width;
    $('#size-v').textContent = s.width;
    vecFill = s.fill;
    checkOne(fillBtns, fillBtns.find((b) => !!b.dataset.fill === s.fill));
    vecAlpha = s.fillAlpha ?? 100;
    $('#fill-alpha').value = vecAlpha;
    $('#fill-alpha-v').textContent = vecAlpha + '%';
    syncFillAlpha();
    if (s.type === 'rect') {
      vecRadius = s.radius || 0;
      $('#corner').value = vecRadius;
      $('#corner-v').textContent = vecRadius;
    }
  }
  renderVectors();
}

// Change the picked shape (if any) when a setting changes.
// One undo step per settings gesture: a slider drag pushes once, then the
// pointer or key letting go (or the input's change) arms it again.
let styleUndoArmed = true;
for (const ev of ['pointerup', 'keyup', 'change']) addEventListener(ev, () => (styleUndoArmed = true));
function updateSelected(props) {
  if (mode !== 'v-select' || !selected) return;
  if (styleUndoArmed) {
    pushHistory();
    styleUndoArmed = false;
  }
  Object.assign(selected, props);
  renderVectors();
}

function deleteSelected() {
  if (!selected) return;
  pushHistory();
  shapes = shapes.filter((s) => s !== selected);
  select(null);
}

function restoreVectors(list) {
  shapes = list;
  draft = [];
  select(null);
}

function stagePoint(e) {
  const r = stage.getBoundingClientRect();
  return [e.clientX - r.left, e.clientY - r.top];
}

// Follow the pointer on the window, since re-rendering replaces the element pressed.
// onEnd hears whether the gesture was cancelled (say, the system took the touch).
function track(onMove, onEnd) {
  const end = (ev) => {
    removeEventListener('pointermove', onMove);
    removeEventListener('pointerup', end);
    removeEventListener('pointercancel', end);
    onEnd?.(ev.type === 'pointercancel');
  };
  addEventListener('pointermove', onMove);
  addEventListener('pointerup', end);
  addEventListener('pointercancel', end);
}

// Turn point (x,y) by angle a round (ox,oy).
function turnPt(x, y, ox, oy, a) {
  const c = Math.cos(a), n = Math.sin(a), dx = x - ox, dy = y - oy;
  return [ox + dx * c - dy * n, oy + dx * n + dy * c];
}

// Start a drag on a shape: pushes an undo step once the pointer really moves.
function startDrag(e, s, onMove) {
  if (mode !== 'v-select' || e.button > 0) return;
  e.preventDefault();
  e.stopPropagation();
  if (s !== selected) select(s);
  const [x0, y0] = stagePoint(e);
  let moved = false;
  track((ev) => {
    const [x, y] = stagePoint(ev);
    if (!moved) {
      if (Math.hypot(x - x0, y - y0) < 3) return;
      moved = true;
      lastTap = { key: '', at: 0 }; // a drag is not a tap, so it can't start a double-tap
      pushHistory();
    }
    onMove(x, y, x - x0, y - y0, ev);
    renderVectors();
  });
}

// Move a shape (end 0) or drag one of its dots (end 1 or 2). A dot follows
// the pointer while the other one stays put, even on a turned shape.
function dragShape(e, s, end) {
  if (!end && mode === 'v-select' && doubleTap('shape') && s === selected) {
    e.preventDefault();
    e.stopPropagation();
    return editPoints(!editing);
  }
  const o = { ...s }, rot = o.rot || 0, [ocx, ocy] = centre(o);
  const fixed = turnPt(end === 1 ? o.x2 : o.x1, end === 1 ? o.y2 : o.y1, ocx, ocy, rot);
  const grab = turnPt(o['x' + end] ?? 0, o['y' + end] ?? 0, ocx, ocy, rot);
  startDrag(e, s, (x, y, dx, dy) => {
    if (!end) {
      s.x1 = o.x1 + dx; s.y1 = o.y1 + dy; s.x2 = o.x2 + dx; s.y2 = o.y2 + dy;
      return;
    }
    const m = [grab[0] + dx, grab[1] + dy], cx = (fixed[0] + m[0]) / 2, cy = (fixed[1] + m[1]) / 2;
    const [fx, fy] = turnPt(...fixed, cx, cy, -rot), [mx, my] = turnPt(...m, cx, cy, -rot);
    const other = end === 1 ? 2 : 1;
    s['x' + end] = mx; s['y' + end] = my;
    s['x' + other] = fx; s['y' + other] = fy;
  });
}

// Spin a shape round its middle. Shift snaps to 15° steps.
function spinShape(e, s) {
  startDrag(e, s, (x, y, dx, dy, ev) => {
    const [cx, cy] = centre(s), step = Math.PI / 12;
    const a = Math.atan2(y - cy, x - cx) + Math.PI / 2;
    s.rot = ev.shiftKey ? Math.round(a / step) * step : a;
  });
}

// A copy of s flipped across the page's middle (fx, fy), then turned by a
// round it. Flipping mirrors the box, so the shape's own turn reverses.
function mirrorCopy(s, fx, fy, a = 0) {
  const ox = stage.clientWidth / 2, oy = stage.clientHeight / 2;
  let [cx, cy] = centre(s), rot = s.rot || 0;
  let dx1 = s.x1 - cx, dy1 = s.y1 - cy, dx2 = s.x2 - cx, dy2 = s.y2 - cy;
  if (fx) { cx = 2 * ox - cx; dx1 = -dx1; dx2 = -dx2; rot = -rot; }
  if (fy) { cy = 2 * oy - cy; dy1 = -dy1; dy2 = -dy2; rot = -rot; }
  [cx, cy] = turnPt(cx, cy, ox, oy, a);
  return { ...s, x1: cx + dx1, y1: cy + dy1, x2: cx + dx2, y2: cy + dy2, rot: rot + a };
}

// Mirror copies match the paint brushes, Snowflake included.
function mirrored(s) {
  if (symMode === 'lr') return [s, mirrorCopy(s, true, false)];
  if (symMode === 'four') return [s, mirrorCopy(s, true, false), mirrorCopy(s, false, true), mirrorCopy(s, true, true)];
  if (symMode === 'k6') {
    const out = [s];
    for (let k = 0; k < 6; k++) {
      if (k) out.push(mirrorCopy(s, false, false, (Math.PI / 3) * k));
      out.push(mirrorCopy(s, true, false, (Math.PI / 3) * k));
    }
    return out;
  }
  return [s];
}

// Shift snaps lines to 45° steps and makes boxes and ovals even.
function constrain(s, x, y) {
  const dx = x - s.x1, dy = y - s.y1;
  if (s.type === 'line') {
    const a = Math.round(Math.atan2(dy, dx) / (Math.PI / 4)) * (Math.PI / 4), len = Math.hypot(dx, dy);
    return [s.x1 + Math.cos(a) * len, s.y1 + Math.sin(a) * len];
  }
  const side = Math.max(Math.abs(dx), Math.abs(dy));
  return [s.x1 + (dx < 0 ? -side : side), s.y1 + (dy < 0 ? -side : side)];
}

// Fit a curve's box round its points and store them as fractions of it.
function fitCurve(s, raw) {
  const xs = raw.map((p) => p[0]), ys = raw.map((p) => p[1]);
  s.x1 = Math.min(...xs); s.x2 = Math.max(...xs);
  s.y1 = Math.min(...ys); s.y2 = Math.max(...ys);
  const w = s.x2 - s.x1, h = s.y2 - s.y1;
  s.pts = raw.map(([x, y]) => [w ? (x - s.x1) / w : 0, h ? (y - s.y1) / h : 0]);
}

// Pressing on the page leaves the toolbar and panel, so keys like Enter act
// on the drawing rather than the last button clicked.
stage.addEventListener('pointerdown', () => {
  if (document.activeElement?.closest('.bar, .panel')) document.activeElement.blur();
}, true);

$('#c').addEventListener('pointerdown', (e) => {
  if (!mode.startsWith('v-') || !fromCanvas(e)) return;
  if (mode === 'v-select') return select(null);
  e.preventDefault();
  const [x, y] = stagePoint(e), raw = [[x, y]];
  const s = { type: mode.slice(2), x1: x, y1: y, x2: x, y2: y, colour: cssColour(), width: brushSize, fill: vecFill, fillAlpha: vecAlpha };
  if (s.type === 'rect') s.radius = vecRadius;
  if (s.type === 'curve') fitCurve(s, raw);
  pushHistory();
  draft = mirrored(s);
  renderVectors();
  track((ev) => {
    let [x, y] = stagePoint(ev);
    if (s.type === 'curve') {
      if (Math.hypot(x - raw.at(-1)[0], y - raw.at(-1)[1]) < 4) return;
      raw.push([x, y]);
      fitCurve(s, raw);
    } else {
      if (ev.shiftKey) [x, y] = constrain(s, x, y);
      s.x2 = x; s.y2 = y;
    }
    draft = mirrored(s);
    renderVectors();
  }, (cancelled) => {
    // A cancelled draw, or a tap with a line, box or oval, makes nothing, so drop its undo step too.
    if (cancelled || (s.type !== 'curve' && Math.hypot(s.x2 - s.x1, s.y2 - s.y1) < 3)) undoStack.pop();
    else shapes.push(...draft);
    draft = [];
    renderVectors();
  });
});

function drawVectors(ctx) {
  for (const s of shapes) {
    const path = new Path2D(shapePath(s)), [cx, cy] = centre(s);
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(s.rot || 0);
    ctx.translate(-cx, -cy);
    ctx.lineCap = ctx.lineJoin = 'round';
    if (isFilled(s)) {
      ctx.fillStyle = s.colour;
      ctx.globalAlpha = (s.fillAlpha ?? 100) / 100;
      ctx.fill(path);
      ctx.globalAlpha = 1;
    }
    ctx.strokeStyle = s.colour;
    ctx.lineWidth = s.width;
    ctx.stroke(path);
    ctx.restore();
  }
}

function randomColour() {
  hue = Math.random() * 360;
}

// Snapshot the paint (and which colouring page is showing) so it can be undone.
function pushHistory() {
  if (!p5Instance) return;
  undoStack.push({ img: p5Instance.get(), page, pageBox, texts: readTexts(), vectors: structuredClone(shapes) });
  if (undoStack.length > 12) undoStack.shift();
}

function undo() {
  const last = p5Instance && undoStack.pop();
  if (!last) return;
  p5Instance.image(last.img, 0, 0);
  restoreTexts(last.texts);
  restoreVectors(last.vectors);
  if (last.page !== page || last.pageBox !== pageBox) {
    page = last.page;
    pageBox = last.pageBox;
    drawLines();
  }
}

function clearCanvas() {
  if (!p5Instance) return;
  pushHistory();
  p5Instance.background(bgColour);
  restoreTexts([]);
  restoreVectors([]);
}

function newPaper(colour, pageName = null) {
  if (!p5Instance) return;
  pushHistory();
  bgColour = colour;
  p5Instance.background(bgColour);
  restoreTexts([]);
  restoreVectors([]);
  setPage(pageName);
}

// The paint with the colouring-page lines on top, at full pixel density.
function paintImage() {
  const out = document.createElement('canvas');
  out.width = $('#c').width;
  out.height = $('#c').height;
  const ctx = out.getContext('2d');
  ctx.drawImage($('#c'), 0, 0);
  ctx.drawImage(linesCanvas, 0, 0);
  return out;
}

// Each text box where it sits on screen, split into lines.
// Offsets ignore the box's turn, which is added back round its middle (cx, cy).
function textRuns() {
  return textBoxes().map((box) => {
    const body = box.querySelector('.text-body'), cs = getComputedStyle(body);
    const size = parseFloat(cs.fontSize), lineH = parseFloat(cs.lineHeight) || size * 1.2;
    return {
      size, lineH, weight: cs.fontWeight, family: cs.fontFamily, colour: cs.color,
      x: box.offsetLeft + body.offsetLeft + parseFloat(cs.paddingLeft),
      y: box.offsetTop + body.offsetTop + parseFloat(cs.paddingTop) + (lineH - size) / 2,
      cx: box.offsetLeft + box.offsetWidth / 2, cy: box.offsetTop + box.offsetHeight / 2,
      rot: +box.dataset.rot || 0,
      lines: body.innerText.split('\n'),
    };
  });
}

function download(name, href) {
  const link = document.createElement('a');
  link.download = name;
  link.href = href;
  link.click();
}

// The whole picture as you see it: paint, page lines, shapes and text.
function composeImage() {
  const out = paintImage(), ctx = out.getContext('2d');
  const pd = out.width / stage.clientWidth;
  ctx.scale(pd, pd);
  drawVectors(ctx);
  ctx.textBaseline = 'top';
  for (const t of textRuns()) {
    ctx.font = `${t.weight} ${t.size}px ${t.family}`;
    ctx.fillStyle = t.colour;
    ctx.save();
    ctx.translate(t.cx, t.cy);
    ctx.rotate((t.rot * Math.PI) / 180);
    ctx.translate(-t.cx, -t.cy);
    t.lines.forEach((line, i) => ctx.fillText(line, t.x, t.y + i * t.lineH));
    ctx.restore();
  }
  return out;
}

function saveImage() {
  download('my-art-' + Date.now() + '.png', composeImage().toDataURL('image/png'));
}

// ---------- My drawings ----------
// Drawings are kept in this browser's localStorage, like the loop synth's
// compositions: the paint as a picture, plus the page, vector shapes and
// text as data, so everything stays editable when opened again.
const DRAWINGS_KEY = 'drawing-app-drawings';
const drawingsDialog = $('#drawings');
const nameInput = $('#drawing-name');
let currentName = '';

function loadDrawings() {
  try {
    const list = JSON.parse(localStorage.getItem(DRAWINGS_KEY) ?? '[]');
    return Array.isArray(list) ? list.filter((d) => typeof d?.name === 'string' && typeof d?.paint === 'string') : [];
  } catch {
    return [];
  }
}

function storeDrawings(list) {
  try {
    localStorage.setItem(DRAWINGS_KEY, JSON.stringify(list));
    return true;
  } catch {
    return false;
  }
}

const sayDrawings = (text) => ($('#drawings-msg').textContent = text);

// A small picture for the list: the whole drawing, shrunk.
function thumbnail() {
  const full = composeImage();
  const t = document.createElement('canvas');
  t.width = 240;
  t.height = Math.round((240 * full.height) / full.width);
  t.getContext('2d').drawImage(full, 0, 0, t.width, t.height);
  return t.toDataURL('image/jpeg', 0.7);
}

function saveDrawing(name) {
  const list = loadDrawings().filter((d) => d.name !== name);
  const entry = {
    name, at: Date.now(), w: stage.clientWidth, h: stage.clientHeight, bg: bgColour,
    page, pageBox, shapes: shapes, texts: readTexts(), thumb: thumbnail(),
    paint: $('#c').toDataURL('image/png'),
  };
  // A busy picture can be big: fall back to a smaller (slightly lossy) copy.
  let ok = storeDrawings([entry, ...list]);
  if (!ok) {
    entry.paint = $('#c').toDataURL('image/webp', 0.9);
    ok = storeDrawings([entry, ...list]);
  }
  if (!ok) return sayDrawings('Not enough room to save. Delete an old drawing and try again.');
  currentName = name;
  nameInput.value = name;
  sayDrawings(`Saved "${name}".`);
  renderDrawings();
}

function openDrawing(d) {
  const img = new Image();
  img.onload = () => {
    pushHistory();
    bgColour = d.bg || bgColour;
    p5Instance.background(bgColour);
    // p5's context is already scaled to CSS pixels, so this fills the saved size.
    p5Instance.drawingContext.drawImage(img, 0, 0, d.w, d.h);
    page = d.page ?? null;
    pageBox = d.pageBox ?? null;
    drawLines();
    restoreTexts(d.texts || []);
    restoreVectors(structuredClone(d.shapes || []));
    currentName = d.name;
    nameInput.value = d.name;
    drawingsDialog.close();
  };
  img.onerror = () => sayDrawings(`"${d.name}" could not be read.`);
  img.src = d.paint;
}

function renderDrawings() {
  const list = loadDrawings();
  $('#drawings-list').replaceChildren(...list.map((d) => {
    const li = document.createElement('li');
    const open = document.createElement('button');
    open.className = 'drawing-open';
    if (d.name === currentName) open.ariaCurrent = 'true';
    open.innerHTML = '<img alt=""><span></span><small></small>';
    open.querySelector('img').src = d.thumb || d.paint;
    open.querySelector('span').textContent = d.name;
    open.querySelector('small').textContent = new Date(d.at).toLocaleDateString();
    open.addEventListener('click', () => openDrawing(d));
    const del = document.createElement('button');
    del.className = 'small drawing-delete';
    del.ariaLabel = `Delete ${d.name}`;
    del.innerHTML = '<i class="ph ph-trash"></i>';
    del.addEventListener('click', () => {
      if (!confirm(`Delete "${d.name}"?`)) return;
      if (storeDrawings(loadDrawings().filter((x) => x.name !== d.name))) {
        if (d.name === currentName) currentName = '';
        renderDrawings();
      }
    });
    li.append(open, del);
    return li;
  }));
  if (!list.length) $('#drawings-list').innerHTML = '<li class="hint">No saved drawings yet.</li>';
}

function showDrawings() {
  sayDrawings('');
  nameInput.value = currentName;
  renderDrawings();
  if (!drawingsDialog.open) drawingsDialog.showModal();
}

$('#drawing-save').addEventListener('submit', (e) => {
  e.preventDefault();
  saveDrawing(nameInput.value.trim() || `Drawing ${loadDrawings().length + 1}`);
});

// An SVG keeps the vector shapes and text as real shapes; the paint goes in as a picture.
function saveSvg() {
  const W = stage.clientWidth, H = stage.clientHeight;
  const esc = (v) => String(v).replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  const parts = [
    `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">`,
    `<image href="${paintImage().toDataURL('image/png')}" width="${W}" height="${H}"/>`,
    ...shapes.map((s) => { const g = svgEl('g', turnAttr(s)); g.append(inkEl(s)); return g.outerHTML; }),
    ...textRuns().map((t) =>
      `<text font-family="${esc(t.family)}" font-size="${t.size}" font-weight="${t.weight}" fill="${esc(t.colour)}" dominant-baseline="text-before-edge" xml:space="preserve"${t.rot ? ` transform="rotate(${t.rot} ${pt(t.cx, t.cy)})"` : ''}>` +
      t.lines.map((line, i) => `<tspan x="${r1(t.x)}" y="${r1(t.y + i * t.lineH)}">${esc(line)}</tspan>`).join('') +
      '</text>'),
    '</svg>',
  ];
  const url = URL.createObjectURL(new Blob(parts, { type: 'image/svg+xml' }));
  download('my-art-' + Date.now() + '.svg', url);
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

// Draw only when the press lands on the canvas with the main button.
function fromCanvas(e) {
  return !!e && e.target === $('#c') && !(e.button > 0);
}

// ---------- Panel ----------
function kindOf(m) {
  if (m === 'pen' || m === 'neon') return 'pen';
  if (m.startsWith('v-')) return 'vector';
  if (['fill', 'eraser', 'emoji', 'text'].includes(m)) return m;
  if (shapeModes.includes(m)) return 'shape';
  return 'fx';
}

function syncPanel() {
  const b = $(`.tool[data-mode="${mode}"]`) || $(`.shape-item[data-shape="${mode}"]`);
  $('#tool-icon').className = b.querySelector('i').className;
  $('#tool-name').textContent = b.dataset.name;
  $('#tool-desc').textContent = b.dataset.desc;
  $$('.field[data-for]').forEach((s) => (s.hidden = !s.dataset.for.split(' ').includes(kindOf(mode))));
  $('#size-name').textContent = kindOf(mode) === 'vector' ? 'Border width' : 'Size';
  syncCornerField();
}

const tools = $$('.tool:not(.menu-trigger)');
tools.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode)));

// The shapes button opens a menu; it then stands in for the picked shape.
const shapeItems = $$('.shape-item');
function pickShape(item) {
  const { shape, desc, name, icon } = item.dataset;
  Object.assign(shapeTrigger.dataset, { mode: shape, desc, name });
  shapeTrigger.querySelector('i').className = 'ph ' + icon;
  markCurrent(shapeItems, item);
  setMode(shape);
}
shapeItems.forEach((b) => b.addEventListener('click', () => pickShape(b)));

// A menu hands focus back to its button, which would leave the button's
// tooltip showing over the menu or the canvas — hide it on open and on pick.
$$('.zui-menu').forEach((menu) => {
  const tipId = menu.querySelector('[data-tooltip-trigger]').dataset.tooltipTrigger;
  const hide = () => setTimeout(() => { try { document.getElementById(tipId).hidePopover(); } catch {} });
  menu.querySelectorAll('.menu-trigger, .menu-item').forEach((el) => el.addEventListener('click', hide));
});
const markCurrent = (items, on) => items.forEach((x) => (x === on ? (x.dataset.current = 'true') : delete x.dataset.current));

for (const [id, set] of [['size', (v) => { brushSize = v; updateActiveBox({ size: textSize() }); updateSelected({ width: v }); }], ['speed', (v) => (speed = v)]]) {
  const el = $('#' + id), out = $('#' + id + '-v');
  el.addEventListener('input', () => { set(+el.value); out.textContent = el.value; });
}

$('#corner').addEventListener('input', (e) => {
  vecRadius = +e.target.value;
  $('#corner-v').textContent = vecRadius;
  if (selected?.type === 'rect') updateSelected({ radius: vecRadius });
});

const WOBBLE_WORDS = ['Very smooth', 'Very smooth', 'Smooth', 'Smooth', 'Natural', 'Natural', 'Natural', 'Wobbly', 'Wobbly', 'Jittery', 'Very jittery'];
$('#wobble').addEventListener('input', (e) => {
  wobble = +e.target.value;
  $('#wobble-v').textContent = WOBBLE_WORDS[wobble];
});

const checkOne = (els, on) => els.forEach((x) => x.setAttribute('aria-checked', String(x === on)));
const swatches = $$('.swatch[data-colour]');
swatches.forEach((b) => b.addEventListener('click', () => {
  rainbowPen = b.dataset.colour === 'rainbow';
  if (!rainbowPen) penColour = b.dataset.colour;
  checkOne(swatches, b);
  updateActiveBox({ colour: cssColour() });
  updateSelected({ colour: cssColour() });
}));
$('#custom-colour').addEventListener('input', (e) => {
  rainbowPen = false;
  penColour = e.target.value;
  checkOne(swatches, null);
  updateActiveBox({ colour: cssColour() });
  updateSelected({ colour: cssColour() });
});

const fontBtns = $$('.font');
fontBtns.forEach((b) => b.addEventListener('click', () => {
  textFont = b.dataset.font;
  checkOne(fontBtns, b);
  updateActiveBox({ font: textFont });
}));

const fillBtns = $$('.vfill');
fillBtns.forEach((b) => b.addEventListener('click', () => {
  vecFill = !!b.dataset.fill;
  checkOne(fillBtns, b);
  syncFillAlpha();
  updateSelected({ fill: vecFill });
}));

// Fill strength only matters for a filled shape.
function syncFillAlpha() {
  $('#fill-alpha-field').hidden = !vecFill;
}
$('#fill-alpha').addEventListener('input', (e) => {
  vecAlpha = +e.target.value;
  $('#fill-alpha-v').textContent = vecAlpha + '%';
  updateSelected({ fillAlpha: vecAlpha });
});

const stickerBtns = $$('.sticker');
stickerBtns.forEach((b) => b.addEventListener('click', () => {
  currentEmoji = b.dataset.sticker;
  stickerBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
}));

const mirrorItems = $$('.menu-item[data-sym]');
mirrorItems.forEach((b) => b.addEventListener('click', () => {
  symMode = b.dataset.sym;
  $('#guides').dataset.sym = symMode;
  mirrorTrigger.dataset.active = String(symMode !== 'off');
  markCurrent(mirrorItems, b);
}));

$$('.menu-item[data-page]').forEach((b) => b.addEventListener('click', () => {
  newPaper('#ffffff', b.dataset.page);
  setMode('fill');
}));
$$('.menu-item[data-paper]').forEach((b) => b.addEventListener('click', () => newPaper(b.dataset.paper)));

const pickOne = (a) => a[Math.floor(Math.random() * a.length)];
const actions = {
  undo,
  clear: clearCanvas,
  save: saveImage,
  drawings: showDrawings,
  closeDrawings: () => drawingsDialog.close(),
  svg: saveSvg,
  vdelete: deleteSelected,
  vpoints: () => editPoints(!editing),
  shuffle: randomColour,
  surprise() {
    const choices = [...tools.filter((t) => !['eraser', 'fill', 'text', 'v-select'].includes(t.dataset.mode)), ...shapeItems];
    const pick = pickOne(choices);
    if (pick.dataset.shape) pickShape(pick);
    else setMode(pick.dataset.mode);
    pickOne(swatches).click();
    if (mode === 'emoji') pickOne(stickerBtns).click();
    randomColour();
  },
};
$$('[data-action]').forEach((b) => b.addEventListener('click', () => actions[b.dataset.action]()));

const magic = $$('.group[aria-label="Magic brushes"] .tool').map((b) => b.dataset.mode);
document.addEventListener('keydown', (e) => {
  // ⌘S saves straight back to the open drawing, or asks for a name.
  if ((e.metaKey || e.ctrlKey) && e.key === 's') {
    e.preventDefault();
    showDrawings();
    if (currentName) saveDrawing(currentName);
    return;
  }
  if (drawingsDialog.open) return;
  if (e.target.closest('input, select, textarea, [contenteditable]')) return;
  if ((e.metaKey || e.ctrlKey) && e.key === 'z') { e.preventDefault(); undo(); return; }
  if (selected && (e.key === 'Delete' || e.key === 'Backspace')) { e.preventDefault(); deleteSelected(); return; }
  if (selected && e.key === 'Escape') { editing ? editPoints(false) : select(null); return; }
  if (selected && (e.key === '[' || e.key === ']')) {
    pushHistory();
    selected.rot = (selected.rot || 0) + (Math.PI / 12) * (e.key === ']' ? 1 : -1);
    renderVectors();
    return;
  }
  // Enter on a focused button already clicks it.
  if (selected && e.key === 'Enter' && !e.target.closest('button')) { editPoints(!editing); return; }
  if (e.metaKey || e.ctrlKey || e.altKey) return;
  const n = +e.key;
  if (n >= 1 && n <= magic.length) return setMode(magic[n - 1]);
  // Letter keys pick tools; H picks whichever stamp shape the Shapes menu shows.
  const k = e.key.toLowerCase();
  if (k === 'h') return setMode(shapeTrigger.dataset.mode);
  const tool = $$('.tool[data-key]').find((b) => b.dataset.key === k);
  if (tool) setMode(tool.dataset.mode);
});

stage.dataset.mode = mode;
syncPanel();

// ---------- Drawing ----------
new p5(function(p) {
  p5Instance = p;

  // Drawing coordinates — set per mirror pass by forEachMirror().
  // jx/jy are a random scatter offset applied to held stamps.
  let cx = 0, cy = 0, px = 0, py = 0, jx = 0, jy = 0;
  // Pen line: smoothed pointer (sx/sy), last drawn point (lx/ly), eased width.
  let sx = 0, sy = 0, lx = 0, ly = 0, penBase = 0, penW = 0;

  // Resize to the stage without losing the drawing.
  function fit() {
    const w = stage.clientWidth, h = stage.clientHeight;
    if (w === p.width && h === p.height) return;
    const snap = p.get();
    p.resizeCanvas(w, h);
    p.background(bgColour);
    p.image(snap, 0, 0);
    undoStack.length = 0; // snapshots no longer match canvas size
    drawLines();
  }

  p.setup = function() {
    p.createCanvas(stage.clientWidth, stage.clientHeight, $('#c'));
    p.colorMode(p.HSB, 360, 100, 100, 100);
    p.background(bgColour);
    drawLines();
    new ResizeObserver(fit).observe(stage);
  };

  p.draw = function() {
    t += 0.02 * speed;
    hue = (hue + 0.3) % 360;
    if (!isDrawing) return;
    if (mode === 'spirograph' || mode === 'lightning') {
      forEachMirror(paintContinuous);
    } else if (mode === 'emoji' || shapeModes.includes(mode)) {
      // Holding still keeps a slow trickle of stamps going; dragging is
      // handled by stampStep(). Speed 5 stamps every 16 frames.
      const still = p.dist(p.pmouseX, p.pmouseY, p.mouseX, p.mouseY) < 1;
      if (still && p.frameCount % Math.max(1, Math.round(80 / speed)) === 0) {
        scatter();
        forEachMirror(stampTick, sx, sy, sx, sy);
        jx = 0; jy = 0;
      }
    }
  };

  p.mousePressed = function(e) {
    if (!fromCanvas(e) || mode.startsWith('v-')) return; // vector tools handle their own pointer
    if (mode === 'text') {
      e.preventDefault(); // keep focus off the canvas so the new box can take it
      addTextAt(p.mouseX, p.mouseY);
      return;
    }
    isDrawing = true;
    prevX = p.mouseX; prevY = p.mouseY;
    sx = lx = p.mouseX; sy = ly = p.mouseY;
    penBase = penW = brushSize;
    pushHistory();
    forEachMirror(paintDown);
  };

  p.mouseReleased = function() {
    // A smoothed pen trails the pointer, so finish the line where it let go.
    if (isDrawing && (mode === 'pen' || mode === 'neon' || mode === 'eraser') && wobble < 5) {
      forEachMirror(paintMove, p.mouseX, p.mouseY, lx, ly);
    }
    isDrawing = false;
  };

  p.mouseDragged = function() {
    if (!isDrawing) return;
    if (mode === 'pen' || mode === 'neon' || mode === 'eraser') penStep();
    else if (mode === 'emoji' || shapeModes.includes(mode)) stampStep();
    else forEachMirror(paintMove);
    prevX = p.mouseX; prevY = p.mouseY;
  };

  // Random offset for a stamp. Fast speeds scatter less, so stamps follow
  // the line like a brush; slow speeds spread them out.
  function scatter() {
    const spread = brushSize * 1.5 * (10 - speed) / 9;
    jx = p.random(-spread, spread);
    jy = p.random(-spread, spread);
  }

  // Lay stamps along the drag path. The gap between them shrinks as Speed
  // rises: 3 stamp-widths at 1, about one at 5, a fifth of one at 10.
  function stampStep() {
    const gap = Math.max(2, brushSize * 2.5 * 3 * Math.pow(0.75, speed - 1));
    let d = p.dist(sx, sy, p.mouseX, p.mouseY);
    while (d >= gap) {
      sx += ((p.mouseX - sx) * gap) / d;
      sy += ((p.mouseY - sy) * gap) / d;
      d -= gap;
      scatter();
      forEachMirror(stampTick, sx, sy, sx, sy);
    }
    jx = 0; jy = 0;
  }

  // Below 5 the pen trails the pointer and eases its width (smooth);
  // above 5 each point and width gets a random nudge (jittery).
  function penStep() {
    const smooth = Math.max(0, 5 - wobble) / 5;
    const jitter = Math.max(0, wobble - 5) / 5;
    const k = 1 - 0.75 * smooth;
    const nx = p.lerp(sx, p.mouseX, k), ny = p.lerp(sy, p.mouseY, k);
    const target = p.map(Math.min(p.dist(sx, sy, nx, ny), 60), 0, 60, brushSize, brushSize * 0.25);
    penBase = p.lerp(penBase, target, 1 - 0.8 * smooth);
    penW = Math.max(1, penBase * (1 + p.random(-0.5, 0.5) * jitter));
    const j = jitter * brushSize * 0.6;
    const tx = nx + p.random(-j, j), ty = ny + p.random(-j, j);
    forEachMirror(paintMove, tx, ty, lx, ly);
    sx = nx; sy = ny; lx = tx; ly = ty;
  }

  // Run fn once per mirror copy, with cx/cy/px/py set for that pass.
  function forEachMirror(fn, mx = p.mouseX, my = p.mouseY, omx = prevX, omy = prevY) {
    const W = p.width, H = p.height;
    let passes = [[mx, my, omx, omy]];
    if (symMode === 'lr') passes.push([W - mx, my, W - omx, omy]);
    if (symMode === 'four') passes.push([W - mx, my, W - omx, omy],
      [mx, H - my, omx, H - omy], [W - mx, H - my, W - omx, H - omy]);
    if (symMode === 'k6') {
      // Snowflake: 6 turns round the centre, each also flipped.
      const ox = W / 2, oy = H / 2;
      const turn = (x, y, a, f) => {
        const dx = (x - ox) * f, dy = y - oy;
        return [ox + dx * Math.cos(a) - dy * Math.sin(a), oy + dx * Math.sin(a) + dy * Math.cos(a)];
      };
      passes = [];
      for (let k = 0; k < 6; k++) {
        const a = (Math.PI / 3) * k;
        for (const f of [1, -1]) passes.push([...turn(mx, my, a, f), ...turn(omx, omy, a, f)]);
      }
    }
    for (const [a, b, c, d] of passes) {
      cx = a; cy = b; px = c; py = d;
      fn();
    }
  }

  function paintDown() {
    if (mode === 'bubbles') spawnBubble();
    if (mode === 'splatter') drawSplatter();
    if (mode === 'glitter') drawGlitter();
    if (mode === 'pen') penDot(ink());
    if (mode === 'neon') drawNeon();
    if (mode === 'fill') floodFill(cx, cy);
    if (mode === 'eraser') penDot(bgColour);
    if (shapeModes.includes(mode)) drawShape(mode);
    if (mode === 'emoji') stampEmoji();
  }

  function paintMove() {
    if (mode === 'trails') drawTrail();
    if (mode === 'splatter') drawSplatter();
    if (mode === 'bubbles') spawnBubble();
    if (mode === 'glitter') drawGlitter();
    if (mode === 'grass') drawGrass();
    if (mode === 'pen') drawPen(ink());
    if (mode === 'neon') drawNeon();
    if (mode === 'ribbon') drawRibbon();
    if (mode === 'eraser') drawPen(bgColour);
  }

  function paintContinuous() {
    if (mode === 'spirograph') drawSpirograph();
    if (mode === 'lightning') drawLightning();
  }

  function stampTick() {
    if (mode === 'emoji') stampEmoji();
    else drawShape(mode);
  }

  // Pen colour, or a slowly shifting hue when the rainbow swatch is picked.
  function ink() {
    return rainbowPen ? p.color(hue, 85, 100) : penColour;
  }

  function penDot(col) {
    p.noStroke();
    p.fill(col);
    p.ellipse(cx, cy, brushSize, brushSize);
  }

  // Width comes from penStep(): slow movement → thick, fast → thin.
  function drawPen(col) {
    p.stroke(col);
    p.strokeWeight(penW);
    p.strokeCap(p.ROUND);
    p.line(px, py, cx, cy);
  }

  function drawNeon() {
    const ctx = p.drawingContext;
    const col = p.color(ink());
    ctx.shadowBlur = brushSize * 1.5;
    ctx.shadowColor = col.toString();
    p.strokeCap(p.ROUND);
    p.stroke(col);
    p.strokeWeight(brushSize * 0.6);
    p.line(px, py, cx, cy);
    ctx.shadowBlur = 0;
    p.stroke(0, 0, 100, 80);
    p.strokeWeight(Math.max(1, brushSize * 0.2));
    p.line(px, py, cx, cy);
  }

  const RIBBON = ['#ff4d4d', '#ff9f1c', '#ffd60a', '#52d273', '#2ec4f1', '#a66cff'];
  function drawRibbon() {
    const dx = cx - px, dy = cy - py, len = Math.hypot(dx, dy);
    if (len < 0.5) return;
    const nx = -dy / len, ny = dx / len;
    const w = Math.max(2, (brushSize * 1.2) / RIBBON.length);
    p.strokeCap(p.ROUND);
    p.strokeWeight(w + 0.5);
    RIBBON.forEach((c, i) => {
      const o = (i - (RIBBON.length - 1) / 2) * w;
      p.stroke(c);
      p.line(px + nx * o, py + ny * o, cx + nx * o, cy + ny * o);
    });
  }

  // Paint-bucket fill on the raw pixels. Colouring-page lines act as walls.
  // ponytail: no anti-alias pass, so faint halos can stay round painted shapes
  // (colouring-page lines sit on top and hide them there).
  function floodFill(x0, y0) {
    const ctx = p.drawingContext, pd = p.pixelDensity();
    const W = ctx.canvas.width, H = ctx.canvas.height;
    const sx = Math.floor(x0 * pd), sy = Math.floor(y0 * pd);
    if (sx < 0 || sy < 0 || sx >= W || sy >= H) return;
    const img = ctx.getImageData(0, 0, W, H), d = img.data;
    const walls = page ? linesCanvas.getContext('2d').getImageData(0, 0, W, H).data : null;
    const [fr, fg, fb] = p.color(ink()).levels;
    const s0 = (sy * W + sx) * 4, tr = d[s0], tg = d[s0 + 1], tb = d[s0 + 2];
    if (Math.abs(tr - fr) + Math.abs(tg - fg) + Math.abs(tb - fb) < 6) return;
    const open = (i) => (!walls || walls[i * 4 + 3] < 40) &&
      Math.abs(d[i * 4] - tr) + Math.abs(d[i * 4 + 1] - tg) + Math.abs(d[i * 4 + 2] - tb) <= 96;
    const seen = new Uint8Array(W * H), stack = new Int32Array(W * H);
    let top = 0;
    const push = (i) => { if (!seen[i] && open(i)) { seen[i] = 1; stack[top++] = i; } };
    push(sy * W + sx);
    while (top) {
      const i = stack[--top], k = i * 4, x = i % W;
      d[k] = fr; d[k + 1] = fg; d[k + 2] = fb; d[k + 3] = 255;
      if (x > 0) push(i - 1);
      if (x < W - 1) push(i + 1);
      if (i >= W) push(i - W);
      if (i < W * H - W) push(i + W);
    }
    ctx.putImageData(img, 0, 0);
  }

  function drawShape(shape) {
    const s = brushSize * 2.5;
    const x = cx + jx, y = cy + jy;
    p.noStroke();
    p.fill(ink());
    if (shape === 'circle') {
      p.ellipse(x, y, s, s);
    } else if (shape === 'square') {
      p.rectMode(p.CENTER);
      p.rect(x, y, s, s, s * 0.12);
    } else if (shape === 'triangle') {
      const r = s * 0.62;
      p.triangle(x, y - r, x - r * 0.87, y + r * 0.5, x + r * 0.87, y + r * 0.5);
    } else if (shape === 'star') {
      polyStar(x, y, s * 0.28, s * 0.6, 5);
    } else if (shape === 'heart') {
      drawHeart(x, y, s);
    }
  }

  function polyStar(x, y, rInner, rOuter, points) {
    p.beginShape();
    for (let i = 0; i < points * 2; i++) {
      const r = i % 2 === 0 ? rOuter : rInner;
      const a = p.PI * i / points - p.HALF_PI;
      p.vertex(x + p.cos(a) * r, y + p.sin(a) * r);
    }
    p.endShape(p.CLOSE);
  }

  function drawHeart(x, y, s) {
    const u = s * 0.5;
    p.beginShape();
    p.vertex(x, y + u * 0.6);
    p.bezierVertex(x, y + u * 0.1, x - u, y - u * 0.3, x - u, y - u * 0.7);
    p.bezierVertex(x - u, y - u * 1.2, x, y - u * 1.2, x, y - u * 0.5);
    p.bezierVertex(x, y - u * 1.2, x + u, y - u * 1.2, x + u, y - u * 0.7);
    p.bezierVertex(x + u, y - u * 0.3, x, y + u * 0.1, x, y + u * 0.6);
    p.endShape(p.CLOSE);
  }

  function stampEmoji() {
    p.noStroke();
    p.textAlign(p.CENTER, p.CENTER);
    p.textSize(brushSize * 3);
    p.text(currentEmoji, cx + jx, cy + jy);
  }

  function drawTrail() {
    let d = p.dist(px, py, cx, cy);
    let steps = p.max(1, p.floor(d / 3));
    for (let i = 0; i < steps; i++) {
      let x = p.lerp(px, cx, i / steps);
      let y = p.lerp(py, cy, i / steps);
      let sz = brushSize + p.sin(t + i * 0.5) * brushSize * 0.5;
      let h2 = (hue + i * 3) % 360;
      p.noStroke();
      p.fill(h2, 90, 95, 60);
      p.ellipse(x, y, sz, sz);
      p.fill(h2, 70, 100, 30);
      p.ellipse(x + p.random(-sz, sz), y + p.random(-sz, sz), sz * 0.3, sz * 0.3);
    }
  }

  function drawSplatter() {
    let count = p.floor(speed * 4) + 5;
    for (let i = 0; i < count; i++) {
      let angle = p.random(p.TWO_PI);
      let dist2 = p.random(brushSize * 0.5, brushSize * 3);
      let x = cx + p.cos(angle) * dist2;
      let y = cy + p.sin(angle) * dist2;
      let sz = p.random(2, brushSize);
      let h2 = (hue + p.random(-30, 30) + 360) % 360;
      p.noStroke();
      p.fill(h2, 90, 95, 80);
      p.ellipse(x, y, sz, sz * p.random(0.3, 1));
    }
    p.fill(hue, 60, 100, 40);
    p.ellipse(cx, cy, brushSize * 1.5, brushSize * 1.5);
  }

  function drawSpirograph() {
    let steps = p.floor(speed * 3) + 3;
    for (let i = 0; i < steps; i++) {
      t += 0.05;
      let R = brushSize * 4, r = brushSize * 2, d = brushSize * 3;
      let x = cx + (R - r) * p.cos(t) + d * p.cos((R - r) / r * t);
      let y = cy + (R - r) * p.sin(t) - d * p.sin((R - r) / r * t);
      let h2 = (hue + t * 20) % 360;
      p.noStroke();
      p.fill(h2, 90, 95, 50);
      p.ellipse(x, y, brushSize * 0.5, brushSize * 0.5);
    }
  }

  function spawnBubble() {
    let count = p.floor(speed * 0.5) + 1;
    for (let i = 0; i < count; i++) {
      let x = cx + p.random(-brushSize * 2, brushSize * 2);
      let y = cy + p.random(-brushSize * 2, brushSize * 2);
      let sz = p.random(brushSize * 0.5, brushSize * 2.5);
      let h2 = (hue + p.random(-40, 40) + 360) % 360;
      p.noFill();
      p.stroke(h2, 70, 95, 70);
      p.strokeWeight(p.random(1, 3));
      p.ellipse(x, y, sz, sz);
      p.noStroke();
      p.fill(h2, 40, 100, 15);
      p.ellipse(x, y, sz, sz);
    }
  }

  function drawLightning() {
    let steps = p.floor(speed * 2) + 2;
    for (let i = 0; i < steps; i++) {
      let x1 = cx + p.random(-brushSize * 3, brushSize * 3);
      let y1 = cy + p.random(-brushSize * 3, brushSize * 3);
      let x2 = x1 + p.random(-brushSize * 4, brushSize * 4);
      let y2 = y1 + p.random(-brushSize * 4, brushSize * 4);
      let h2 = (hue + p.random(-20, 20) + 360) % 360;
      p.stroke(h2, 60, 100, 80);
      p.strokeWeight(p.random(1, 3));
      p.line(x1, y1, x2, y2);
      let mx = (x1 + x2) / 2 + p.random(-10, 10);
      let my = (y1 + y2) / 2 + p.random(-10, 10);
      p.stroke(h2, 30, 100, 50);
      p.strokeWeight(1);
      p.line(x1, y1, mx, my);
      p.line(mx, my, x2, y2);
    }
  }

  function drawGlitter() {
    const n = p.floor(speed * 0.8) + 2;
    p.noStroke();
    for (let i = 0; i < n; i++) {
      const x = cx + p.random(-brushSize * 1.5, brushSize * 1.5);
      const y = cy + p.random(-brushSize * 1.5, brushSize * 1.5);
      const r = p.random(brushSize * 0.15, brushSize * 0.6);
      p.fill((hue + p.random(-60, 60) + 360) % 360, 35, 100, 90);
      polyStar(x, y, r * 0.25, r, 4);
    }
  }

  function drawGrass() {
    const n = p.floor(speed * 0.6) + 2;
    p.noFill();
    p.strokeCap(p.ROUND);
    for (let i = 0; i < n; i++) {
      const x = cx + p.random(-brushSize, brushSize);
      const y = cy + p.random(-brushSize * 0.3, brushSize * 0.3);
      const len = p.random(brushSize * 0.8, brushSize * 2.5);
      const lean = p.random(-0.5, 0.5);
      p.stroke(p.random(85, 140), p.random(55, 90), p.random(45, 90), 90);
      p.strokeWeight(p.random(1, 2.5));
      p.bezier(x, y, x, y - len * 0.5, x + lean * len * 0.5, y - len * 0.8, x + lean * len, y - len);
    }
  }
});
</script>

<style>
  /* Lab bar → tool bar → canvas + panel → footer, filling the window. */
  .app {
    flex: 1; min-height: 480px; display: grid; grid-template-rows: auto 1fr;
    color: var(--color-text); background: var(--color-background);
  }

  .bar {
    display: flex; align-items: center; gap: var(--space-xs); padding: var(--space-2xs) var(--space-md);
    border-block-end: var(--border-style) 2px var(--color-border); flex-wrap: wrap;
  }
  .group { display: flex; gap: 2px; flex: none; }
  .group + .group { padding-inline-start: var(--space-xs); border-inline-start: var(--border-style) 2px var(--color-border); }
  .spacer { flex: 1; }
  .tool {
    width: 36px; height: 36px; flex: none; display: grid; place-items: center;
    border: var(--border-style) 2px transparent; border-radius: var(--radius-md);
    background: transparent; color: inherit; font-size: var(--step-1); cursor: pointer;
  }
  .tool:hover { border-color: var(--color-border); }
  .menu-trigger { width: auto; gap: 1px; padding: 0 var(--space-3xs); display: flex; align-items: center; }
  .menu-trigger .caret { font-size: var(--step--2); }
  .menu-list { z-index: var(--z-3); min-width: 10rem; }
  .menu-item { gap: var(--space-2xs); }
  .menu-item i, .menu-emoji { font-size: var(--step-1); line-height: 1; }
  .menu-item[data-current] { background: var(--color-accent); color: var(--color-black); }
  .menu-paper { width: 1.25em; height: 1.25em; border: var(--border-style) 2px var(--color-border); background: var(--c); }
  .tool[aria-pressed=true], .tool[data-active=true] { background: var(--color-accent); color: var(--color-black); border-color: var(--color-border); }
  .act {
    height: 36px; flex: none; display: flex; align-items: center; gap: var(--space-3xs); padding: 0 var(--space-xs);
    border: var(--border-style) 2px var(--color-border); border-radius: var(--radius-md);
    background: var(--color-surface); color: inherit; font: inherit; font-size: var(--step--1); font-weight: 700; cursor: pointer;
  }
  .act:hover { background: var(--color-background); }
  .act span { white-space: nowrap; }
  .primary { background: var(--color-accent); color: var(--color-black); }
  .primary:hover { background: var(--color-accent); filter: brightness(1.08); }

  .main { display: grid; grid-template-columns: 1fr 280px; min-height: 0; }
  .stage { position: relative; min-height: 0; overflow: hidden; }
  .stage canvas { position: absolute; inset: 0; }
  #c { cursor: crosshair; touch-action: none; }
  #lines { pointer-events: none; }
  .stage[data-mode=text] #c { cursor: text; }
  .stage[data-mode=v-select] #c { cursor: default; }
  /* Faint lines through the centre showing where the mirror folds. */
  .guides {
    position: absolute; inset: 0; pointer-events: none;
    --g: color-mix(in oklab, var(--color-text) 30%, transparent);
    --v: linear-gradient(90deg, transparent calc(50% - 1px), var(--g) 0 calc(50% + 1px), transparent 0);
  }
  .guides[data-sym=lr] { background: var(--v); }
  .guides[data-sym=four] { background: var(--v), linear-gradient(0deg, transparent calc(50% - 1px), var(--g) 0 calc(50% + 1px), transparent 0); }
  .guides[data-sym=k6] { background: var(--v),
    linear-gradient(30deg, transparent calc(50% - 1px), var(--g) 0 calc(50% + 1px), transparent 0),
    linear-gradient(150deg, transparent calc(50% - 1px), var(--g) 0 calc(50% + 1px), transparent 0); }

  .panel {
    display: flex; flex-direction: column; gap: var(--space-sm); padding: var(--space-sm);
    border-inline-start: var(--border-style) 2px var(--color-border); background: var(--color-surface);
