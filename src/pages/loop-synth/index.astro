---
import Layout from '../../layouts/Layout.astro'
import { Button, Field, Input, Label, Menu, MenuContent, MenuItem, MenuTrigger } from '@mrmartineau/zui/astro'
import { MAX_STEPS, ROWS, SLOTS, STEP_OPTIONS, WAVES } from '../../components/loop-synth/song'

export const title = 'Loop Synth'
export const description =
	'Draw tunes on a grid, chain patterns into loops, save and export them. All sound made live with the Web Audio API.'
export const date = '2026-10-08'
export const status = 'live'
export const tags = ['audio', 'web-audio', 'music', 'tool']

const colours = ['rose', 'orange', 'amber', 'lime', 'emerald', 'sky', 'indigo', 'fuchsia']
const colour = (r: number) => (r < colours.length ? `var(--color-${colours[r]}-400)` : 'var(--color-text)')
const mix = [
	{ id: 'delay', label: 'Delay' },
	{ id: 'reverb', label: 'Reverb' },
]
const firstDrum = ROWS.findIndex((r) => 'drum' in r)
---

<Layout title="Loop Synth — lab.zander.wtf">
	<div class="ls-app">
		<h1 class="sr-only">Loop Synth</h1>

		<header class="ls-bar">
			<div class="ls-group" aria-label="Playback">
				<Button id="ls-play-song" class="ls-play" size="sm"><i class="ph ph-play"></i> Play song</Button>
				<Button id="ls-play-pattern" class="ls-play" variant="outline" size="sm"
					><i class="ph ph-repeat"></i> <span>Loop A</span></Button
				>
				<Button
					id="ls-follow"
					class="ls-play"
					variant="outline"
					size="sm"
					aria-pressed="false"
					title="Show the pattern that is playing"
					><i class="ph ph-crosshair"></i> Follow</Button
				>
			</div>

			<div class="ls-group">
				<label class="ls-range" for="ls-bpm">
					<span>Tempo</span>
					<input id="ls-bpm" type="range" min="60" max="180" step="1" />
					<output id="ls-bpm-out" for="ls-bpm"></output>
				</label>
			</div>

			<div class="ls-group" aria-label="Settings">
				<Menu>
					<MenuTrigger size="sm" aria-label="Sound">
						<i id="ls-wave-icon" class="ph ph-wave-triangle"></i>
						<span id="ls-wave-label">triangle</span>
						<i class="ph ph-caret-down ls-caret" aria-hidden="true"></i>
					</MenuTrigger>
					<MenuContent class="ls-menu">
						{
							WAVES.map((w) => (
								<MenuItem class="ls-menu-item" data-wave={w}>
									<i class={`ph ph-wave-${w}`} />
									{w}
								</MenuItem>
							))
						}
					</MenuContent>
				</Menu>
				<Menu>
					<MenuTrigger size="sm" aria-label="Steps per pattern">
						<i class="ph ph-dots-nine"></i>
						<span id="ls-steps-label">16 steps</span>
						<i class="ph ph-caret-down ls-caret" aria-hidden="true"></i>
					</MenuTrigger>
					<MenuContent class="ls-menu">
						{
							STEP_OPTIONS.map((n) => (
								<MenuItem class="ls-menu-item" data-steps-option={n}>
									{n} steps
								</MenuItem>
							))
						}
					</MenuContent>
				</Menu>
			</div>

			<span class="ls-spacer"></span>
			<span id="ls-status" class="ls-status" role="status"></span>

			<Menu align="end">
				<MenuTrigger size="sm" variant="fill">
					<i class="ph ph-export"></i> Export
					<i class="ph ph-caret-down ls-caret" aria-hidden="true"></i>
				</MenuTrigger>
				<MenuContent class="ls-menu">
					<MenuItem id="ls-wav" class="ls-menu-item"><i class="ph ph-waveform"></i> Audio (WAV)</MenuItem>
					<MenuItem id="ls-midi" class="ls-menu-item"><i class="ph ph-piano-keys"></i> MIDI file</MenuItem>
					<MenuItem id="ls-share" class="ls-menu-item"><i class="ph ph-link"></i> Copy share link</MenuItem>
				</MenuContent>
			</Menu>
		</header>

		<div class="ls-main">
			<aside class="ls-side ls-left" aria-labelledby="ls-comp-title">
				<h2 id="ls-comp-title"><i class="ph ph-music-notes"></i> Compositions</h2>
				<form id="ls-save" class="ls-save">
					<Field>
						<Label for="ls-name">Name</Label>
						<Input id="ls-name" maxlength="60" placeholder="Untitled tune" autocomplete="off" />
					</Field>
					<Button type="submit" size="sm"><i class="ph ph-floppy-disk"></i> Save</Button>
				</form>
				<p class="ls-hint">Saved in this browser. Saving with the same name replaces it.</p>
				<ul id="ls-comps" class="ls-comps"></ul>
			</aside>

			<section class="ls-stage" aria-label="Pattern editor">
				<div class="ls-stage-head">
					<div class="ls-slots" role="group" aria-label="Pattern to edit">
						{
							SLOTS.map((s, i) => (
								<Button class="ls-slot" variant="outline" size="sm" data-slot={i}>
									{s}
								</Button>
							))
						}
					</div>
					<Button id="ls-clear" variant="outline" size="sm"
						><i class="ph ph-eraser"></i> <span>Clear A</span></Button
					>
					<Menu>
						<MenuTrigger size="sm" icon aria-label="Pattern actions">
							<i class="ph ph-dots-three"></i>
						</MenuTrigger>
						<MenuContent class="ls-menu">
							<MenuItem id="ls-copy" class="ls-menu-item"><i class="ph ph-copy"></i> Copy pattern</MenuItem>
							<MenuItem id="ls-paste" class="ls-menu-item" disabled
								><i class="ph ph-clipboard-text"></i> Paste pattern</MenuItem
							>
						</MenuContent>
					</Menu>
					<p class="ls-hint">Click squares to add notes. Space plays and pauses.</p>
				</div>

				<div class="ls-fit">
					<div class="ls-grid" id="ls-grid">
						{
							ROWS.map((row, r) => (
								<>
									{r === firstDrum && <span class="ls-gap" aria-hidden="true" />}
									<span class:list={['ls-label', { 'ls-drum': 'drum' in row }]}>{row.name}</span>
									{Array.from({ length: MAX_STEPS }, (_, c) => (
										<button
											class:list={['ls-cell', { 'ls-beat': c % 4 === 0, 'ls-extra': c >= 16 }]}
											style={`--c: ${colour(r)}`}
											data-row={r}
											data-col={c}
											aria-pressed="false"
											aria-label={`${row.name}, step ${c + 1}`}
										/>
									))}
								</>
							))
						}
					</div>
				</div>
			</section>

			<aside class="ls-side ls-right" aria-label="Song and mix">
				<section class="ls-block" aria-labelledby="ls-song-title">
					<h2 id="ls-song-title"><i class="ph ph-list-numbers"></i> Song</h2>
					<p class="ls-hint">Bars play in order, then loop. Click a bar to change its pattern.</p>
					<ol id="ls-chain" class="ls-chain"></ol>
					<div class="ls-chain-tools">
						<Button id="ls-add" variant="outline" size="sm"><i class="ph ph-plus"></i> Bar</Button>
						<Button id="ls-remove" variant="outline" size="sm" icon aria-label="Remove the last bar"
							><i class="ph ph-minus"></i></Button
						>
						<Button id="ls-clear-song" variant="outline" size="sm" color="destructive"
							><i class="ph ph-trash"></i> Clear song</Button
						>
					</div>
				</section>
				<section class="ls-block" aria-labelledby="ls-mix-title">
					<h2 id="ls-mix-title"><i class="ph ph-sliders-horizontal"></i> Mix</h2>
					{
						mix.map((m) => (
							<div class="ls-knob">
								<label for={`ls-${m.id}`}>
									{m.label} <output id={`ls-${m.id}-out`} for={`ls-${m.id}`} />
								</label>
								<input id={`ls-${m.id}`} type="range" min="0" max="100" step="1" />
							</div>
						))
					}
				</section>
			</aside>
		</div>
	</div>
</Layout>

<script>
	import {
		DEFAULT_SONG,
		MAX_CHAIN,
		ROWS,
		SLOTS,
		decodeSong,
		encodeSong,
		isOn,
		toggle,
		type Song,
	} from '../../components/loop-synth/song'
	import { playRow, render, start } from '../../components/loop-synth/synth'
	import { midi, wav } from '../../components/loop-synth/export'

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T

	const song = decodeSong(location.hash.slice(1)) ?? structuredClone(DEFAULT_SONG)
	let edit = song.chain[0]
	let mode: 'song' | 'pattern' | null = null
	let stop: (() => void) | null = null
	let clip: number[] | null = null

	const cells = [...document.querySelectorAll<HTMLButtonElement>('.ls-cell')]
	const slots = [...document.querySelectorAll<HTMLButtonElement>('.ls-slot')]
	const playSong = $<HTMLButtonElement>('ls-play-song')
	const playPattern = $<HTMLButtonElement>('ls-play-pattern')
	const grid = $('ls-grid')
	const chain = $<HTMLOListElement>('ls-chain')
	const waveItems = [...document.querySelectorAll<HTMLElement>('[data-wave]')]
	const stepItems = [...document.querySelectorAll<HTMLElement>('[data-steps-option]')]
	const nameInput = $<HTMLInputElement>('ls-name')
	const status = $('ls-status')
	let sayTimer = 0
	/** Shows a short message in the toolbar, then clears it. */
	function say(text: string) {
		status.textContent = text
		clearTimeout(sayTimer)
		sayTimer = window.setTimeout(() => (status.textContent = ''), 4000)
	}

	const save = () => history.replaceState(null, '', `#${encodeSong(song)}`)

	/* ───────────── render ───────────── */

	function renderGrid() {
		const p = song.patterns[edit]
		for (const cell of cells) {
			cell.ariaPressed = String(isOn(p, +cell.dataset.row!, +cell.dataset.col!))
		}
		slots.forEach((s, i) => (s.ariaPressed = String(i === edit)))
		grid.dataset.steps = String(song.steps)
		playPattern.querySelector('span')!.textContent = `Loop ${SLOTS[edit]}`
		$('ls-clear').querySelector('span')!.textContent = `Clear ${SLOTS[edit]}`
	}

	function renderChain() {
		chain.replaceChildren(
			...song.chain.map((slot, i) => {
				const li = document.createElement('li')
				const b = document.createElement('button')
				b.className = 'zui-button zui-button-variant-outline zui-button-size-sm ls-link'
				b.textContent = SLOTS[slot]
				b.ariaLabel = `Bar ${i + 1}: pattern ${SLOTS[slot]}`
				b.onclick = () => {
					song.chain[i] = (slot + 1) % SLOTS.length
					renderChain()
					save()
				}
				li.append(b)
				return li
			}),
		)
		$<HTMLButtonElement>('ls-add').disabled = song.chain.length >= MAX_CHAIN
		$<HTMLButtonElement>('ls-remove').disabled = song.chain.length <= 1
	}

	/* ───────────── controls ───────────── */

	type Knob = 'bpm' | 'delay' | 'reverb'
	const knobs = (['bpm', 'delay', 'reverb'] as Knob[]).map((key) => {
		const input = $<HTMLInputElement>(`ls-${key}`)
		const out = $<HTMLOutputElement>(`ls-${key}-out`)
		const show = () => (out.value = key === 'bpm' ? `${song[key]} BPM` : `${song[key]}%`)
		input.oninput = () => {
			song[key] = +input.value
			show()
			save()
		}
		return () => {
			input.value = String(song[key])
			show()
		}
	})

	function renderControls() {
		knobs.forEach((sync) => sync())
		for (const el of waveItems) el.toggleAttribute('data-current', el.dataset.wave === song.wave)
		for (const el of stepItems) el.toggleAttribute('data-current', +el.dataset.stepsOption! === song.steps)
		$('ls-wave-icon').className = `ph ph-wave-${song.wave}`
		$('ls-wave-label').textContent = song.wave
		$('ls-steps-label').textContent = `${song.steps} steps`
	}

	for (const el of waveItems) {
		el.onclick = () => {
			song.wave = el.dataset.wave as Song['wave']
			renderControls()
			save()
		}
	}
	for (const el of stepItems) {
		el.onclick = () => {
			song.steps = +el.dataset.stepsOption! as Song['steps']
			renderControls()
			renderGrid()
			save()
		}
	}

	/* ───────────── playback ───────────── */

	function clearPlayhead() {
		document.querySelectorAll('.is-now').forEach((el) => el.classList.remove('is-now'))
	}

	const follow = $<HTMLButtonElement>('ls-follow')
	follow.onclick = () => (follow.ariaPressed = String(follow.ariaPressed !== 'true'))

	function onStep(link: number, col: number) {
		clearPlayhead()
		chain.children[link]?.classList.add('is-now')
		if (link !== -1 && song.chain[link] !== edit) {
			if (follow.ariaPressed !== 'true') return
			edit = song.chain[link]
			renderGrid()
		}
		for (const cell of cells) if (+cell.dataset.col! === col) cell.classList.add('is-now')
	}

	// Media keys only reach a page that is playing a media element, and Web
	// Audio doesn't count, so this silent loop plays alongside the music.
	// ponytail: silent stand-in; if a browser ignores silent media, route the
	// real output through it (MediaStreamDestination → srcObject) instead.
	// Chrome ignores media under 5 seconds, hence 6.
	const silence = new Audio(
		URL.createObjectURL(new Blob([wav([new Float32Array(6 * 8000)], 8000)], { type: 'audio/wav' })),
	)
	silence.loop = true

	let resumeAt = 0 // step a pause stopped at
	let lastMode: NonNullable<typeof mode> = 'song'

	/** Switches playback; returns the step the old playback stopped at. */
	function setPlaying(next: typeof mode, from = 0) {
		const at = stop?.() ?? 0
		stop = null
		clearPlayhead()
		mode = next
		if (mode) {
			lastMode = mode
			stop = start(song, onStep, mode === 'pattern' ? () => edit : undefined, from)
			silence.play().catch(() => {})
		} else silence.pause()
		if ('mediaSession' in navigator) {
			navigator.mediaSession.playbackState = mode ? 'playing' : 'paused'
			navigator.mediaSession.metadata = new MediaMetadata({
				title: nameInput.value.trim() || 'Untitled tune',
				artist: 'Loop Synth',
			})
		}
		playSong.innerHTML =
			mode === 'song' ? '<i class="ph ph-stop"></i> Stop' : '<i class="ph ph-play"></i> Play song'
		playPattern.querySelector('i')!.className = mode === 'pattern' ? 'ph ph-stop' : 'ph ph-repeat'
		playPattern.ariaPressed = String(mode === 'pattern')
		return at
	}

	// On-screen buttons start from the top; Space and media keys pause/resume.
	playSong.onclick = () => {
		resumeAt = 0
		setPlaying(mode === 'song' ? null : 'song')
	}
	playPattern.onclick = () => {
		resumeAt = 0
		setPlaying(mode === 'pattern' ? null : 'pattern')
	}

	const pause = () => {
		if (mode) resumeAt = setPlaying(null)
	}
	const resume = () => {
		if (!mode) setPlaying(lastMode, resumeAt)
	}

	if ('mediaSession' in navigator) {
		navigator.mediaSession.setActionHandler('play', resume)
		navigator.mediaSession.setActionHandler('pause', pause)
		navigator.mediaSession.setActionHandler('stop', () => {
			resumeAt = 0
			setPlaying(null)
		})
	}

	addEventListener('keydown', (e) => {
		if (e.key !== ' ' || e.repeat || e.metaKey || e.ctrlKey || e.altKey) return
		// Leave Space alone where it types or opens a menu.
		if ((e.target as Element).closest('input:not([type=range]), textarea, select, [contenteditable]')) return
		e.preventDefault() // also stops Space pressing a focused button
		if (mode) pause()
		else resume()
	})

	/* ───────────── editing ───────────── */

	for (const cell of cells) {
		cell.onclick = () => {
			const r = +cell.dataset.row!
			const c = +cell.dataset.col!
			toggle(song.patterns[edit], r, c)
			const on = isOn(song.patterns[edit], r, c)
			cell.ariaPressed = String(on)
			if (on && !mode) playRow(r, song)
			save()
		}
	}

	slots.forEach((s, i) => {
		s.onclick = () => {
			edit = i
			clearPlayhead()
			renderGrid()
		}
	})

	$('ls-copy').onclick = () => {
		clip = [...song.patterns[edit]]
		const paste = $<HTMLButtonElement>('ls-paste')
		paste.disabled = false
		delete paste.dataset.disabled // ZUI menus skip items marked disabled
		say(`Copied pattern ${SLOTS[edit]}.`)
	}
	$('ls-paste').onclick = () => {
		if (!clip) return
		song.patterns[edit] = [...clip]
		renderGrid()
		save()
	}
	$('ls-clear').onclick = () => {
		song.patterns[edit] = ROWS.map(() => 0)
		renderGrid()
		save()
		say(`Cleared pattern ${SLOTS[edit]}.`)
	}

	// Keeps tempo, sound and mix; empties every pattern and the name, so the
	// next save is a new composition rather than overwriting the old one.
	$('ls-clear-song').onclick = () => {
		if (!confirm('Clear every pattern and start a new song?')) return
		song.patterns = song.patterns.map(() => ROWS.map(() => 0))
		song.chain = [0]
		edit = 0
		resumeAt = 0
		nameInput.value = ''
		renderAll()
		save()
		say('Song cleared.')
	}

	$('ls-add').onclick = () => {
		song.chain.push(edit)
		renderChain()
		save()
	}
	$('ls-remove').onclick = () => {
		song.chain.pop()
		renderChain()
		save()
	}

	/* ───────────── export + share ───────────── */

	const fileName = () =>
		(nameInput.value.trim() || 'loop-synth').replace(/[^\w-]+/g, '-').replace(/^-|-$/g, '').toLowerCase() ||
		'loop-synth'

	function download(data: Uint8Array<ArrayBuffer>, type: string, ext: string) {
		const a = document.createElement('a')
		a.href = URL.createObjectURL(new Blob([data], { type }))
		a.download = `${fileName()}.${ext}`
		a.click()
		setTimeout(() => URL.revokeObjectURL(a.href), 1000)
	}

	const wavBtn = $<HTMLButtonElement>('ls-wav')
	wavBtn.onclick = async () => {
		wavBtn.disabled = true
		try {
			const buf = await render(song)
			download(wav([buf.getChannelData(0), buf.getChannelData(1)], buf.sampleRate), 'audio/wav', 'wav')
		} finally {
			wavBtn.disabled = false
		}
	}
	$('ls-midi').onclick = () => download(midi(song), 'audio/midi', 'mid')

	$('ls-share').onclick = async () => {
		save()
		await navigator.clipboard.writeText(location.href)
		say('Link copied.')
	}

	/* ───────────── compositions ───────────── */

	type Saved = { name: string; code: string; at: number }
	const KEY = 'ls-compositions'
	const comps = $<HTMLUListElement>('ls-comps')

	function loadList(): Saved[] {
		try {
			const list = JSON.parse(localStorage.getItem(KEY) ?? '[]')
			return Array.isArray(list)
				? list.filter((x) => typeof x?.name === 'string' && typeof x?.code === 'string')
				: []
		} catch {
			return []
		}
	}

	function storeList(list: Saved[]) {
		try {
			localStorage.setItem(KEY, JSON.stringify(list))
			return true
		} catch {
			say("Couldn't save — this browser has storage turned off.")
			return false
		}
	}

	function renderComps() {
		const current = nameInput.value.trim()
		comps.replaceChildren(
			...loadList().map((x) => {
				const li = document.createElement('li')
				const load = document.createElement('button')
				load.className = 'zui-button zui-button-variant-ghost ls-comp'
				if (x.name === current) load.ariaCurrent = 'true'
				load.innerHTML = '<i class="ph ph-music-notes"></i><span></span><small></small>'
				load.querySelector('span')!.textContent = x.name
				const bpm = decodeSong(x.code)?.bpm
				const date = new Date(x.at).toLocaleDateString()
				load.querySelector('small')!.textContent = bpm ? `${bpm} BPM · ${date}` : date
				load.onclick = () => openComp(x)
				const del = document.createElement('button')
				del.className = 'zui-button zui-button-variant-ghost zui-button-icon zui-button-size-sm'
				del.ariaLabel = `Delete ${x.name}`
				del.innerHTML = '<i class="ph ph-trash"></i>'
				del.onclick = () => {
					if (!confirm(`Delete "${x.name}"?`)) return
					if (storeList(loadList().filter((y) => y.name !== x.name))) renderComps()
				}
				li.append(load, del)
				return li
			}),
		)
	}

	function openComp(x: Saved) {
		const s = decodeSong(x.code)
		if (!s) {
			say(`"${x.name}" could not be read.`)
			return
		}
		Object.assign(song, s) // in place: the player reads this object
		edit = song.chain[0]
		nameInput.value = x.name
		say('')
		renderAll()
		save()
	}

	$<HTMLFormElement>('ls-save').onsubmit = (e) => {
		e.preventDefault()
		const list = loadList()
		const name = nameInput.value.trim() || `Tune ${list.length + 1}`
		nameInput.value = name
		const entry = { name, code: encodeSong(song), at: Date.now() }
		if (storeList([entry, ...list.filter((y) => y.name !== name)])) {
			say(`Saved "${name}".`)
			renderComps()
		}
	}

	function renderAll() {
		renderControls()
		renderGrid()
		renderChain()
		renderComps()
	}

	renderAll()
</script>

<style>
	/* Lab bar → toolbar → panels + grid → footer, filling the window. */
	.ls-app {
		/* A 0px basis keeps tall panels from stretching the page; it fills the window instead. */
		flex: 1 1 0px;
		min-height: 22rem;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
	}

	/* ───────────── toolbar ───────────── */

	.ls-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-xs);
		padding: var(--space-2xs) var(--space-md);
		border-block-end: var(--border-style) 2px var(--color-border);
	}
	.ls-group {
		display: flex;
		align-items: center;
		gap: var(--space-3xs);
	}
	.ls-group + .ls-group {
		padding-inline-start: var(--space-xs);
		border-inline-start: var(--border-style) 2px var(--color-border);
	}
	.ls-spacer {
		flex: 1;
	}
	.ls-status {
		font-size: var(--step--1);
		opacity: 0.7;
	}
	.ls-range {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
		font-size: var(--step--1);
		font-weight: 700;
	}
	input[type='range'] {
