---
import Layout from '../layouts/Layout.astro'
import { Badge } from '@mrmartineau/zui/astro'
import { buildLabItems, labHref, statusColor } from '../data/lab'

// Discover every `src/pages/<slug>/index.{astro,md}` and read its frontmatter.
const modules = import.meta.glob('./*/index.{astro,md}', { eager: true })
const items = buildLabItems(modules)
const [newest, ...rest] = items

const dateFmt = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
})
const pad = (n: number) => String(n).padStart(2, '0')
---

<Layout title="lab.zander.wtf">
	<main class="page">
		<header class="head">
			<h1>lab<span>.</span>zander<span>.</span>wtf</h1>
			<p>Ideas, experiments, toys and small tools. Some of them work.</p>
		</header>

		<!-- role=list: Safari drops list semantics once list-style is none -->
		<ul class="grid" role="list">
			{
				newest ? (
					<li class="hero-cell">
						<a class="tile hero" href={labHref(newest)}>
							<span class="hearts" data-hearts={newest.slug} hidden><i class="ph ph-heart" aria-hidden="true"></i> <span>0</span><span class="sr-only"> hearts</span></span>
							{newest.date && (
								<span class="kicker">
									Newest · <time datetime={newest.date}>{dateFmt.format(new Date(newest.date))}</time>
								</span>
							)}
							<span class="num">{pad(items.length)}</span>
							<span class="title">{newest.title}</span>
							{newest.description && <span class="desc">{newest.description}</span>}
							<span class="go">
								Open <i class="ph ph-arrow-right" aria-hidden="true"></i>
							</span>
						</a>
					</li>
				) : (
					<li><p class="tile empty">No lab items yet.</p></li>
				)
			}
			{
				rest.map((item, i) => (
					<li>
						<a class:list={['tile', { archived: item.status === 'archived' }]} href={labHref(item)}>
							<span class="row">
								<span class="num">{pad(rest.length - i)}</span>
								<span class="row-end">
									{item.status !== 'live' && (
										<Badge color={statusColor[item.status]}>{item.status}</Badge>
									)}
									<span class="hearts" data-hearts={item.slug} hidden><i class="ph ph-heart" aria-hidden="true"></i> <span>0</span><span class="sr-only"> hearts</span></span>
								</span>
							</span>
							<span class="title">{item.title}</span>
							{item.description && <span class="desc">{item.description}</span>}
							<span class="foot">
								<time datetime={item.date}>{item.date.slice(0, 4)}</time>
								<span>{item.tags?.slice(0, 2).map((tag) => `#${tag}`).join(' ')}</span>
							</span>
						</a>
					</li>
				))
			}
			<li>
				<a class="tile repo" href="https://github.com/mrmartineau/lab.zander.wtf">
					<i class="ph ph-github-logo" aria-hidden="true"></i>
					<span class="title">Source</span>
					<span class="desc">Every experiment, on GitHub.</span>
				</a>
			</li>
		</ul>
	</main>
</Layout>

<script>
	// Heart counts from /api/reactions. Tiles with no hearts show nothing, and
	// so does the whole page if the request fails.
	import type { Stats } from './api/reactions'

	try {
		const res = await fetch('/api/reactions', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ action: 'stats' }),
		})
		if (res.ok) {
			const { items }: Stats = await res.json()
			const compact = new Intl.NumberFormat('en-GB', { notation: 'compact' })
			for (const { slug, hearts } of items) {
				const el = document.querySelector<HTMLElement>(`[data-hearts="${CSS.escape(slug)}"]`)
				if (!el || !hearts) continue
				el.querySelector('span')!.textContent = compact.format(hearts)
				el.hidden = false
			}
		}
	} catch {}
</script>

<style>
	/* Heart counts sit top right: in the row with the badge on small tiles,
	   pinned to the corner on the hero, which lays out from the bottom. */
	.hearts {
		font-family: var(--font-code);
		font-size: var(--step--1);
		white-space: nowrap;
	}
	.row-end {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
	}
	.hero {
		position: relative;
	}
	.hero > .hearts {
		position: absolute;
		inset-block-start: var(--space-sm);
		inset-inline-end: var(--space-sm);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.page {
		padding: var(--space-lg) var(--space-md) var(--space-xl);
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}
	.head h1 {
		margin: 0;
		font-size: clamp(var(--step-4), 11vw, 10rem);
		line-height: 0.85;
		letter-spacing: -0.04em;
	}
	.head h1 span {
		color: var(--color-accent);
	}
	.head p {
		margin: var(--space-sm) 0 0;
		font-size: var(--step-1);
		max-width: 30ch;
	}
	.grid {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
		border-block-start: var(--border-style) 2px var(--color-border);
		border-inline-start: var(--border-style) 2px var(--color-border);
	}
	.grid > li {
		display: flex;
	}
	.tile {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-height: 14rem;
		margin: 0;
		padding: var(--space-sm);
		border-block-end: var(--border-style) 2px var(--color-border);
		border-inline-end: var(--border-style) 2px var(--color-border);
		color: inherit;
		text-decoration: none;
		transition: background-color 150ms var(--ease);
	}
	a.tile:hover,
	a.tile:focus-visible {
		background: var(--color-accent);
		color: var(--color-gray-950);
	}
	.hero-cell {
		grid-column: span 2;
		grid-row: span 2;
	}
	.hero {
		background: var(--color-theme);
		color: var(--color-background);
		justify-content: end;
	}
	@media (max-width: 36rem) {
		.hero-cell {
			grid-column: auto;
			grid-row: auto;
		}
	}
	.hero .num {
		font-size: var(--step-6);
	}
	.hero .title {
		font-size: var(--step-4);
	}
	.hero .desc {
		font-size: var(--step-1);
		max-width: 40ch;
	}
	.kicker {
		font-family: var(--font-code);
		font-size: var(--step--1);
		color: var(--color-accent);
	}
	.hero:hover .kicker,
	.hero:focus-visible .kicker {
		color: inherit;
	}
	.go {
		margin-block-start: var(--space-sm);
		font-weight: 600;
		display: inline-flex;
		gap: var(--space-3xs);
		align-items: center;
	}
	.row {
		display: flex;
		justify-content: space-between;
		align-items: start;
	}
	.num {
		font-family: var(--font-code);
		font-size: var(--step-3);
		line-height: 1;
	}
	.title {
		font-size: var(--step-1);
		font-weight: 700;
		line-height: 1.1;
	}
	.desc {
		font-size: var(--step--1);
		opacity: 0.75;
	}
	.foot {
		margin-block-start: auto;
		display: flex;
		justify-content: space-between;
		gap: var(--space-2xs);
		font-family: var(--font-code);
		font-size: var(--step--2);
		opacity: 0.6;
	}
	.archived {
		opacity: 0.55;
	}
	.repo {
		justify-content: end;
	}
	.repo i {
		font-size: var(--step-4);
	}
	.empty {
		opacity: 0.6;
	}
</style>
